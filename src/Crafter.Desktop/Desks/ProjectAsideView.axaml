<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desks="using:Crafter.Presentation.Desks"
             xmlns:pages="using:Crafter.Presentation.Projects"
             xmlns:todos="using:Crafter.Presentation.Todos"
             x:Class="Crafter.Desktop.Desks.ProjectAsideView"
             x:DataType="desks:ProjectAsideViewModel">
  <UserControl.Styles>
    <Style Selector="Button.tab">
      <Setter Property="Height" Value="{StaticResource BarHeight}" />
    </Style>
    <Style Selector="TextBlock.about">
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="0,8" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="TextBlock.todo">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.todo.done">
      <Setter Property="TextDecorations" Value="Strikethrough" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="Border.row Button.icon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.row:pointerover Button.icon, Border.row Button.icon:focus-visible">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1,0,0,0">
    <DockPanel>
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="16" Margin="14,0">
          <Button Classes="tab" Classes.chosen="{Binding ShowsTodos}" Command="{Binding ShowTodosCommand}" AutomationProperties.Name="Todos">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Todos" />
              <TextBlock Classes="mono" VerticalAlignment="Center" Text="{Binding Todos.Left}" IsVisible="{Binding Todos.HasLeft}" />
            </StackPanel>
          </Button>
          <Button Classes="tab" Classes.chosen="{Binding ShowsSkills}" Content="Skills" Command="{Binding ShowSkillsCommand}" />
          <Button Classes="tab" Classes.chosen="{Binding ShowsAxioms}" Content="Axioms" Command="{Binding ShowAxiomsCommand}" />
        </StackPanel>
      </Border>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Panel Margin="14,14,14,16">
          <Panel IsVisible="{Binding ShowsTodos}">
            <StackPanel Spacing="10" DataContext="{Binding Todos}" x:DataType="todos:TodoListViewModel">
              <TextBox Text="{Binding NewTodo}" PlaceholderText="Something left to do" AutomationProperties.Name="New todo">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <TextBlock Classes="about" Text="Nothing left to do. Add a todo here, or ask the agent to." IsVisible="{Binding !HasTodos}" />
              <ItemsControl ItemsSource="{Binding Todos}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="todos:TodoViewModel">
                    <Border Classes="row" Background="Transparent">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                        <CheckBox VerticalAlignment="Top" MinWidth="0" IsChecked="{Binding IsDone}" AutomationProperties.Name="{Binding Label, StringFormat='Done {0}'}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Classes="mono" Text="{Binding Label}" />
                          <TextBlock Classes="todo" Classes.done="{Binding IsDone}" Text="{Binding Text}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Classes="icon"
                                Command="{Binding CiteCommand}"
                                ToolTip.Tip="Cite in the chat"
                                AutomationProperties.Name="{Binding Label, StringFormat='Cite {0}'}">
                          <Path Data="M13,7.6 L8.1,12.5 A3,3 0 0 1 3.9,8.3 L9.3,2.9 A2,2 0 0 1 12.1,5.7 L6.8,11 A1,1 0 0 1 5.4,9.6 L10.2,4.8" />
                        </Button>
                        <Button Grid.Column="3"
                                Classes="icon"
                                Command="{Binding RemoveCommand}"
                                ToolTip.Tip="Remove"
                                AutomationProperties.Name="{Binding Label, StringFormat='Remove {0}'}">
                          <Path Data="M4,4 L12,12 M12,4 L4,12" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Panel>

          <Panel IsVisible="{Binding ShowsSkills}">
            <StackPanel Spacing="10" DataContext="{Binding Brief}" x:DataType="pages:ProjectBriefViewModel">
              <TextBlock Classes="about" Text="Library skills this project's agent gets. Defaults come from Preferences → Library and reach every project; tick others for this one. Call a skill in a chat with /." />
              <TextBlock Classes="about" Text="The library has no skills yet." IsVisible="{Binding !HasSkills}" />
              <ItemsControl ItemsSource="{Binding Skills}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:SkillChoiceViewModel">
                    <Border Classes="row">
                      <CheckBox IsChecked="{Binding IsGiven}" IsEnabled="{Binding CanChange}" AutomationProperties.Name="{Binding Skill.Name}">
                        <StackPanel Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Text="{Binding Skill.Name}" />
                            <TextBlock Classes="mono" VerticalAlignment="Center" Text="default" IsVisible="{Binding IsDefault}" />
                          </StackPanel>
                          <TextBlock Classes="about" Text="{Binding Skill.Description}" />
                        </StackPanel>
                      </CheckBox>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Panel>

          <Panel IsVisible="{Binding ShowsAxioms}">
            <StackPanel Spacing="10" DataContext="{Binding Brief}" x:DataType="pages:ProjectBriefViewModel">
              <TextBlock Classes="about" Text="Rules this project's agent follows in every chat. The agent can propose one; you approve it in the chat. A chat takes a change when its session starts again." />
              <TextBox Text="{Binding NewAxiom}" PlaceholderText="A rule the agent always follows" AutomationProperties.Name="New axiom">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding AddAxiomCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <TextBlock Classes="about" Text="No axioms yet." IsVisible="{Binding !HasAxioms}" />
              <ItemsControl ItemsSource="{Binding Axioms}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:AxiomViewModel">
                    <Border Classes="row" Background="Transparent">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="{StaticResource FontSizeBody}" Text="{Binding Text}" />
                        <Button Grid.Column="1"
                                Classes="icon"
                                Command="{Binding DropCommand}"
                                ToolTip.Tip="Remove"
                                AutomationProperties.Name="Remove axiom">
                          <Path Data="M4,4 L12,12 M12,4 L4,12" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Panel>
        </Panel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
