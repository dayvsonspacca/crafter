<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:projects="using:Crafter.Desktop.Projects"
             xmlns:desks="using:Crafter.Presentation.Desks"
             xmlns:pages="using:Crafter.Presentation.Projects"
             xmlns:prose="using:Crafter.Desktop.Prose"
             x:Class="Crafter.Desktop.Desks.ProjectOverviewView"
             x:DataType="desks:ProjectOverviewViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.about">
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.recents">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusContainer}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.recent">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="{StaticResource PadRow}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.recent.last">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.recent:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.recent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.action">
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="Button.recent:pointerover TextBlock.action">
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.action.open, Button.recent:pointerover TextBlock.action.open">
      <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel MaxWidth="760" Margin="24,48,24,32" Spacing="{StaticResource Space8}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space4}">
        <Border Width="64"
                Height="64"
                CornerRadius="14"
                ClipToBounds="True"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource SurfaceBrush}">
          <Panel>
            <Image Source="{Binding IconFile, Converter={x:Static projects:IconFileConverter.Instance}}" Stretch="UniformToFill" IsVisible="{Binding HasIcon}" />
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}"
                       Text="{Binding Letter}"
                       IsVisible="{Binding ShowsLetter}" />
            <Path Width="30"
                  Height="30"
                  Stretch="Uniform"
                  StrokeThickness="1.5"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Stroke="{DynamicResource ForegroundBrush}"
                  Data="M2,7.5 L8,2.5 L14,7.5 M3.5,6.5 V13.5 H12.5 V6.5 M6.5,13.5 V9.5 H9.5 V13.5"
                  IsVisible="{Binding IsHome}" />
          </Panel>
        </Border>
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   FontSize="{StaticResource FontSizeLargeTitle}"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding Name}" />
        <Button Grid.Column="2" Classes="primary" Content="New chat" Command="{Binding NewChatCommand}" />
      </Grid>

      <StackPanel Spacing="{StaticResource Space6}">
        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" IsVisible="{Binding !IsHome}">
          <StackPanel Orientation="Horizontal" Spacing="20">
            <Button Classes="tab" Classes.chosen="{Binding ShowsChats}" Content="Chats" Command="{Binding ShowChatsCommand}" />
            <Button Classes="tab" Classes.chosen="{Binding ShowsDetails}" Content="Details" Command="{Binding ShowDetailsCommand}" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="{StaticResource Space2}" IsVisible="{Binding ShowsChats}">
          <Grid ColumnDefinitions="*,Auto" Margin="4,0">
            <TextBlock FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Text="Recent chats" />
            <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Count}" />
          </Grid>
          <Border Classes="recents" IsVisible="{Binding HasRecent}">
            <ItemsControl ItemsSource="{Binding Recent}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="desks:RecentChatViewModel">
                  <Button Classes="recent"
                          Classes.last="{Binding IsLast}"
                          Command="{Binding $parent[UserControl].((desks:ProjectOverviewViewModel)DataContext).ResumeCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Title}">
                    <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="14">
                      <Panel Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse Classes="pulse" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsCrafting}" />
                        <Ellipse Fill="{DynamicResource AccentSecondaryBrush}" IsVisible="{Binding IsUnread}" />
                        <Ellipse Stroke="{DynamicResource IdleBrush}" StrokeThickness="1" IsVisible="{Binding IsIdle}" />
                      </Panel>
                      <StackPanel Grid.Column="1" Spacing="3">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <TextBlock FontSize="{StaticResource FontSizeContent}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                          <TextBlock Grid.Column="1" Classes="mono" Text="{Binding When}" />
                        </Grid>
                        <TextBlock FontSize="{StaticResource FontSizeBody}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                   Text="{Binding Last}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Classes="action" Classes.open="{Binding IsOpen}" Text="{Binding Action}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <TextBlock Margin="4,0"
                     FontSize="{StaticResource FontSizeBody}"
                     Foreground="{DynamicResource ForegroundMutedBrush}"
                     Text="No chats yet. Start one with New chat or Ctrl+T."
                     IsVisible="{Binding !HasRecent}" />
        </StackPanel>

        <ContentControl Content="{Binding Details}" IsVisible="{Binding ShowsDetails}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="pages:ProjectDetailsViewModel">
              <StackPanel Spacing="22">
                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="Name" />
                  <TextBlock Classes="about" Text="How Crafter shows this project." />
                  <TextBox MaxWidth="420" HorizontalAlignment="Left" MinWidth="420" Text="{Binding Name}" AutomationProperties.Name="Name" />
                </StackPanel>

                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="Icon" />
                  <TextBlock Classes="about" Text="Any image. Crafter keeps a copy in the project." />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="44"
                            Height="44"
                            CornerRadius="10"
                            ClipToBounds="True"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Background="{DynamicResource SurfaceBrush}">
                      <Panel>
                        <Image Source="{Binding PreviewFile, Converter={x:Static projects:IconFileConverter.Instance}}" Stretch="UniformToFill" IsVisible="{Binding HasPreview}" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding Letter}"
                                   IsVisible="{Binding !HasPreview}" />
                      </Panel>
                    </Border>
                    <Button Classes="ghost" VerticalAlignment="Center" Content="Choose…" Command="{Binding ChooseIconCommand}" />
                    <Button Classes="ghost" VerticalAlignment="Center" Content="Remove" Command="{Binding RemoveIconCommand}" IsVisible="{Binding HasPreview}" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <TextBlock Classes="label" Text="Summary" />
                    <Button Grid.Column="1" Classes="chip" Content="{Binding InheritLabel}" Command="{Binding InheritCommand}" IsVisible="{Binding CanInherit}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <Button Classes="chip" Classes.chosen="{Binding IsWriting}" Content="Write" Command="{Binding WriteCommand}" />
                      <Button Classes="chip" Classes.chosen="{Binding IsPreviewing}" Content="Preview" Command="{Binding PreviewCommand}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Classes="about" Text="What the project is, read by its agent before every chat. Rules go in its axioms. A chat takes a change when its session starts again." />
                  <TextBox MinHeight="260"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           VerticalContentAlignment="Top"
                           Text="{Binding Summary}"
                           PlaceholderText="What it is, its stack, how it is laid out and the commands it runs with. Markdown reads drawn in Preview."
                           AutomationProperties.Name="Summary"
                           IsVisible="{Binding IsWriting}" />
                  <Border Classes="prose-preview" MinHeight="260" IsVisible="{Binding IsPreviewing}">
                    <prose:ProseView Markdown="{Binding Summary}" />
                  </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                  <Button Classes="ghost" Content="Discard" Command="{Binding DiscardCommand}" />
                  <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
