<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversations="using:Crafter.Presentation.Conversations"
             xmlns:background="using:Crafter.Presentation.Conversations.Background"
             xmlns:controls="using:Crafter.Desktop.Controls"
             x:Class="Crafter.Desktop.Conversations.JobsView"
             x:DataType="conversations:ConversationViewModel"
             IsVisible="{Binding IsJobsOpen, FallbackValue=False}"
             Focusable="True">
  <UserControl.Styles>
    <Style Selector="Button.job">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.job:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.job:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.job TextBlock.what">
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Path.glyph">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="StrokeThickness" Value="1.2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Stroke" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.empty">
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="Border.output">
      <Setter Property="Margin" Value="0,2,0,8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    </Style>
  </UserControl.Styles>

  <controls:Modal Title="Background jobs" IsCompact="True" Dismissed="Dismiss">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="12,14,12,16" Spacing="6">
        <TextBlock Classes="empty"
                   Margin="8,0"
                   Text="Nothing running. Shells, monitors and agents the chat starts in the background show up here."
                   IsVisible="{Binding !HasJobs}" />
        <ItemsControl ItemsSource="{Binding Jobs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="background:JobViewModel">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                  <Button Classes="job" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Description}">
                    <Grid ColumnDefinitions="8,16,*,Auto" ColumnSpacing="8">
                      <Ellipse Classes="pulse" Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}" />
                      <Path Grid.Column="1" Classes="glyph" Data="M2.5,3.5 H13.5 V12.5 H2.5 Z M4.5,6 L6.5,8 L4.5,10 M8,10 H11" IsVisible="{Binding IsShell}" />
                      <Path Grid.Column="1" Classes="glyph" Data="M1.5,8 H4.5 L6,4.5 L8.5,11.5 L10,8 H14.5" IsVisible="{Binding IsMonitor}" />
                      <Path Grid.Column="1" Classes="glyph" Data="M8,2 L9.5,6.5 L14,8 L9.5,9.5 L8,14 L6.5,9.5 L2,8 L6.5,6.5 Z" IsVisible="{Binding IsAgent}" />
                      <TextBlock Grid.Column="2" Classes="what" TextTrimming="CharacterEllipsis" Text="{Binding Description}" ToolTip.Tip="{Binding Kind}" />
                      <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Elapsed}" />
                    </Grid>
                  </Button>
                  <Button Grid.Column="1"
                          Classes="chip"
                          Margin="4,0,0,0"
                          Content="Stop"
                          Command="{Binding StopCommand}"
                          IsEnabled="{Binding !IsStopping}"
                          AutomationProperties.Name="Stop this job" />
                </Grid>
                <Border Classes="output" IsVisible="{Binding IsOpen}">
                  <SelectableTextBlock FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                       FontSize="12"
                                       LineHeight="19"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                       Text="{Binding Output}" />
                </Border>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </controls:Modal>
</UserControl>
