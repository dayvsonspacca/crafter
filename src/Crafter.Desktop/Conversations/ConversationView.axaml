<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversations="using:Crafter.Presentation.Conversations"
             xmlns:messages="using:Crafter.Presentation.Conversations.Messages"
             xmlns:composing="using:Crafter.Presentation.Conversations.Composing"
             xmlns:folders="using:Crafter.Presentation.Folders"
             xmlns:core="using:Crafter.Core.Conversations"
             xmlns:conversationViews="using:Crafter.Desktop.Conversations"
             xmlns:controls="using:Crafter.Desktop.Controls"
             xmlns:prose="using:Crafter.Desktop.Prose"
             x:Class="Crafter.Desktop.Conversations.ConversationView"
             x:DataType="conversations:ConversationViewModel">
  <UserControl.Styles>

    <Style Selector="Border.pill">
      <Setter Property="Padding" Value="9,2" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill.agent TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.pill.waiting">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>
    <Style Selector="Border.pill.waiting TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>
    <Style Selector="ItemsControl.aside">
      <Setter Property="Margin" Value="8,10,0,12" />
    </Style>
    <Style Selector="StackPanel.activity">
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.act">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.act:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.act:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Button.act TextBlock.what">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Border.output">
      <Setter Property="Margin" Value="0,2,0,8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    </Style>
    <Style Selector="Border.approval">
      <Setter Property="Margin" Value="0,6,0,16" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Border.approval.open">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>

    <Style Selector="TextBox.feedback">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.pick">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.pick:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pick:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.pick.chosen /template/ ContentPresenter#PART_ContentPresenter, Button.pick.chosen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Border.slot">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Rectangle.wire">
      <Setter Property="Width" Value="2" />
      <Setter Property="Margin" Value="0,6" />
      <Setter Property="RadiusX" Value="1" />
      <Setter Property="RadiusY" Value="1" />
      <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="TextBlock.bench">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <Style Selector="Button.earlier">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Margin" Value="0,0,0,26" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.earlier:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.jump">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.jump:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style Selector="Border.composer">
      <Setter Property="MaxWidth" Value="760" />
      <Setter Property="Padding" Value="16,12,12,12" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusContainer}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <!-- The same two shadows as the glow, clear, so focusing fades it in. -->
      <Setter Property="BoxShadow" Value="0 0 0 3 #00000000, 0 0 18 0 #00000000" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.composer:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource ComposerGlow}" />
    </Style>
    <Style Selector="Border.composer TextBlock.hint">
      <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.composer TextBlock.hint.armed">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Border.composer TextBlock.hint.refused">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource RemovedBrush}" />
    </Style>
    <Style Selector="Border.composer:focus-within TextBlock.hint">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBox.prompt">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MaxHeight" Value="240" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeContent}" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="TextBox.prompt /template/ Border#PART_BorderElement, TextBox.prompt:pointerover /template/ Border#PART_BorderElement, TextBox.prompt:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.mentions">
      <Setter Property="MaxWidth" Value="760" />
      <Setter Property="Margin" Value="24,0,24,6" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="BoxShadow" Value="0 6 18 0 #40000000" />
    </Style>
    <Style Selector="Button.mention">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.mention:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.mention:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.mention.chosen /template/ ContentPresenter#PART_ContentPresenter, Button.mention.chosen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    </Style>
    <Style Selector="Button.mention TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.mention TextBlock.hit">
      <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.mention TextBlock.where">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="Border.picture">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="64" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    </Style>
    <!-- A file sent along: its name on a card, the agent gets it as an @ reference. -->
    <Style Selector="Border.file">
      <Setter Property="Height" Value="40" />
      <Setter Property="MaxWidth" Value="240" />
      <Setter Property="Padding" Value="10,0,12,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    </Style>
    <Style Selector="Border.file Path">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="StrokeThickness" Value="1.1" />
      <Setter Property="Stroke" Value="{DynamicResource ForegroundMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.file TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.picture.sent">
      <Setter Property="Width" Value="120" />
      <Setter Property="Height" Value="90" />
    </Style>
    <Style Selector="Button.unattach">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,-6,-6,0" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="Button.unattach:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.unattach:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.stop">
      <Setter Property="Height" Value="{StaticResource ControlLarge}" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.stop /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.stop:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.stop:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="StackPanel.tools">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Grid.answer:pointerover StackPanel.tools, Grid.answer.last StackPanel.tools, StackPanel.tools:focus-within">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.note">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.note.failure">
      <Setter Property="BorderBrush" Value="{DynamicResource RemovedBrush}" />
    </Style>
    <Style Selector="Border.note.failure TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RemovedBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- The whole chat takes dropped files, so a drop lands even when the pointer misses the composer. -->
  <Panel DragDrop.AllowDrop="True" Background="Transparent">
    <DockPanel>
      <Border DockPanel.Dock="Top"
              Height="{StaticResource HeaderHeight}"
              Padding="16,0"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
          <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" MaxWidth="420" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
          <Border Grid.Column="1" Classes="pill waiting" IsVisible="{Binding IsWaiting}">
            <TextBlock Classes="mono" Text="waiting for you" />
          </Border>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
            <Border Classes="pill agent">
              <TextBlock Classes="mono" Text="{Binding AgentName}" />
            </Border>
            <Border Classes="pill" IsVisible="{Binding HasModel}">
              <TextBlock Classes="mono" Text="{Binding Model}" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel DockPanel.Dock="Bottom" Margin="24,8,24,16" Spacing="8">
        <!-- As wide as the composer, so the clock starts at its left edge however wide the window. -->
        <StackPanel Orientation="Horizontal" Spacing="10" MaxWidth="760" Margin="6,0,0,0" IsVisible="{Binding ShowsClock}">
          <!-- The bench: the ring fills one cell at a time, then folds into the centre, which
               flashes and holds as the result. -->
          <controls:CraftingCells Motion="Bench"
                                  Width="21"
                                  Height="21"
                                  VerticalAlignment="Center"
                                  IsCrafting="{Binding ShowsClock}"
                                  On="{DynamicResource AccentBrush}"
                                  Off="{DynamicResource BorderBrush}"
                                  Flash="{DynamicResource ForegroundBrush}" />
          <TextBlock Classes="mono bench" Text="{Binding Elapsed}" />
        </StackPanel>
        <Border x:Name="Composer" Classes="composer">
          <StackPanel Spacing="8">
            <ItemsControl ItemsSource="{Binding Attached}" IsVisible="{Binding HasAttached}" Padding="0,6,6,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="10" LineSpacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="composing:AttachmentViewModel">
                  <Panel VerticalAlignment="Center">
                    <Border Classes="picture" IsVisible="{Binding IsPicture}">
                      <Image Source="{Binding Picture, Converter={x:Static conversationViews:PictureConverter.Instance}}" Stretch="UniformToFill" />
                    </Border>
                    <Border Classes="file" IsVisible="{Binding IsFile}" ToolTip.Tip="{Binding File}">
                      <DockPanel>
                        <Path DockPanel.Dock="Left" Data="M4.5,1.5 H9.5 L12.5,4.5 V14.5 H4.5 Z M9.5,1.5 V4.5 H12.5" />
                        <TextBlock Text="{Binding Name}" />
                      </DockPanel>
                    </Border>
                    <Button Classes="unattach" Content="×" Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}" />
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:PromptBox x:Name="PromptBox"
                                Classes="prompt"
                                Text="{Binding Draft}"
                                PlaceholderText="Describe the recipe…"
                                AutomationProperties.Name="Message" />
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space2}">
              <Button Classes="icon" Click="Browse" ToolTip.Tip="Attach files" AutomationProperties.Name="Attach files">
                <Path Data="M13,7.6 L8.1,12.5 A3,3 0 0 1 3.9,8.3 L9.3,2.9 A2,2 0 0 1 12.1,5.7 L6.8,11 A1,1 0 0 1 5.4,9.6 L10.2,4.8" />
              </Button>
              <Panel Grid.Column="1">
                <TextBlock Classes="hint" Text="Enter to craft · Shift+Enter for a new line" IsVisible="{Binding !IsAsking}" />
                <TextBlock Classes="hint" Text="Esc to stop and edit the prompt" IsVisible="{Binding IsAsking}" />
                <TextBlock Classes="hint armed" Text="Press Esc again to clear" IsVisible="{Binding IsClearArmed}" />
                <TextBlock Classes="hint refused" Text="{Binding Refusal}" IsVisible="{Binding IsRefused}" />
              </Panel>
              <Panel Grid.Column="2">
                <Button Classes="primary" Content="Craft" Command="{Binding CraftCommand}" IsVisible="{Binding !IsAsking}" />
                <Button Classes="stop" Content="Stop" Command="{Binding CraftCancelCommand}" IsVisible="{Binding IsAsking}" />
              </Panel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <Panel>
        <TextBlock IsVisible="{Binding !HasMessages}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="15"
                   Text="{Binding ProjectName, StringFormat='Start a chat in {0}.'}" />

        <ScrollViewer x:Name="Scroller" IsVisible="{Binding HasMessages}" ScrollChanged="Follow">
          <StackPanel MaxWidth="760" Margin="24,24,24,12">
            <Button Classes="earlier" Content="{Binding EarlierLabel}" Command="{Binding ShowEarlierCommand}" IsVisible="{Binding HasEarlier}" />
            <ItemsControl ItemsSource="{Binding Messages}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <!-- Not virtualized: a virtualizing panel guesses the height of messages it has not
                       drawn and moves the reader when the guess changes. The chat shows its latest
                       few messages and brings earlier ones in as the reader scrolls up. -->
                  <StackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.DataTemplates>
                <DataTemplate DataType="messages:YourMessageViewModel">
                  <Grid ColumnDefinitions="28,*" ColumnSpacing="16">
                    <DockPanel>
                      <Border DockPanel.Dock="Top" Classes="slot">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                   Text="YOU" />
                      </Border>
                      <Rectangle Classes="wire" IsVisible="{Binding !IsLast}" />
                    </DockPanel>
                    <Border Grid.Column="1"
                            Margin="0,0,0,24"
                            Padding="16,12"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Background="{DynamicResource SurfaceBrush}">
                      <StackPanel Spacing="10">
                        <ItemsControl ItemsSource="{Binding Pictures}" IsVisible="{Binding HasPictures}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel ItemSpacing="8" LineSpacing="8" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="core:Picture">
                              <Border Classes="picture sent">
                                <Image Source="{Binding, Converter={x:Static conversationViews:PictureConverter.Instance}}" Stretch="UniformToFill" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding HasFiles}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel ItemSpacing="8" LineSpacing="8" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Border Classes="file">
                                <DockPanel>
                                  <Path DockPanel.Dock="Left" Data="M4.5,1.5 H9.5 L12.5,4.5 V14.5 H4.5 Z M9.5,1.5 V4.5 H12.5" />
                                  <TextBlock Text="{Binding}" />
                                </DockPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <prose:ProseText Text="{Binding Text}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeContent}" LineHeight="22" IsVisible="{Binding HasText}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </DataTemplate>

                <DataTemplate DataType="messages:CrafterMessageViewModel">
                  <Grid Classes="answer" Classes.last="{Binding IsLast}" ColumnDefinitions="28,*" ColumnSpacing="16" Background="Transparent">
                    <DockPanel>
                      <Border DockPanel.Dock="Top" Classes="slot">
                        <controls:CraftingCells Width="19"
                                                Height="19"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsCrafting="{Binding IsCrafting}"
                                                On="{DynamicResource AccentBrush}"
                                                Off="{DynamicResource BorderBrush}" />
                      </Border>
                      <Rectangle Classes="wire" IsVisible="{Binding !IsLast}" />
                    </DockPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,32" Spacing="{StaticResource Space3}">
                      <TextBlock Classes="mono" Margin="8,3,0,0" Text="woke up · a background job reported" IsVisible="{Binding IsWoken}" />
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.DataTemplates>
                          <DataTemplate DataType="messages:TextSegmentViewModel">
                            <ItemsControl ItemsSource="{Binding Pieces}" Classes.aside="{Binding FollowsActivity}">
                              <ItemsControl.DataTemplates>
                                <DataTemplate DataType="messages:ProseViewModel">
                                  <prose:ProseView Markdown="{Binding Text}" />
                                </DataTemplate>
                                <DataTemplate DataType="messages:CodeBlockViewModel">
                                  <Border Margin="0,4,0,12"
                                          CornerRadius="9"
                                          ClipToBounds="True"
                                          BorderThickness="1"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          Background="{DynamicResource BackgroundBrush}">
                                    <DockPanel>
                                      <Border DockPanel.Dock="Top"
                                              Padding="12,5,6,5"
                                              Background="{DynamicResource SurfaceBrush}"
                                              BorderBrush="{DynamicResource BorderBrush}"
                                              BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*,Auto">
                                          <TextBlock Classes="mono" Text="{Binding Language}" />
                                          <Button Grid.Column="1" Classes="chip" Content="Copy" Command="{Binding CopyCommand}" />
                                        </Grid>
                                      </Border>
                                      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <controls:HighlightedCode Margin="14,12"
                                                                       FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                                                       FontSize="{StaticResource FontSizeCallout}"
                                                                       LineHeight="20"
                                                                       Tokens="{Binding Tokens}" />
                                      </ScrollViewer>
                                    </DockPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.DataTemplates>
                            </ItemsControl>
                          </DataTemplate>
                          <DataTemplate DataType="messages:ActivityItemViewModel">
                            <StackPanel Classes="activity">
                              <Button Classes="act" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Summary}">
                                <Grid ColumnDefinitions="14,84,*,Auto" ColumnSpacing="10">
                                  <Panel Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse Classes="pulse" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsRunning}" />
                                    <Ellipse Fill="{DynamicResource AddedBrush}" IsVisible="{Binding IsFine}" />
                                    <Ellipse Fill="{DynamicResource RemovedBrush}" IsVisible="{Binding IsFailed}" />
                                  </Panel>
                                  <TextBlock Grid.Column="1" Classes="mono" TextTrimming="CharacterEllipsis" Text="{Binding Tool}" ToolTip.Tip="{Binding Tool}" />
                                  <TextBlock Grid.Column="2" Classes="mono what" TextTrimming="CharacterEllipsis" Text="{Binding Summary}" />
                                  <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Result}" IsVisible="{Binding ShowsResult}" />
                                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowsChanges}">
                                    <TextBlock Classes="mono" Foreground="{DynamicResource AddedBrush}" Text="{Binding Added}" />
                                    <TextBlock Classes="mono" Foreground="{DynamicResource RemovedBrush}" Text="{Binding Removed}" IsVisible="{Binding Removed, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                  </StackPanel>
                                </Grid>
                              </Button>
                              <Border Classes="output" IsVisible="{Binding IsExpanded}">
                                <prose:ProseText FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                                 FontSize="12"
                                                 LineHeight="19"
                                                 TextWrapping="Wrap"
                                                 Foreground="{DynamicResource ForegroundMutedBrush}"
                                                 Text="{Binding Output}" />
                              </Border>
                            </StackPanel>
                          </DataTemplate>
                          <DataTemplate DataType="messages:ApprovalItemViewModel">
                            <Border Classes="approval" Classes.open="{Binding IsOpen}">
                              <StackPanel Spacing="10">
                                <TextBlock FontSize="{StaticResource FontSizeBody}" Text="{Binding Asking}" />
                                <Border Padding="12,9"
                                        CornerRadius="7"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Background="{DynamicResource BackgroundBrush}">
                                  <prose:ProseText FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Summary}" />
                                </Border>
                                <TextBlock FontSize="{StaticResource FontSizeCallout}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Text="{Binding Reason}"
                                           IsVisible="{Binding HasReason}" />
                                <TextBox Classes="feedback"
                                         Text="{Binding Feedback}"
                                         PlaceholderText="{Binding FeedbackHint}"
                                         AutomationProperties.Name="Why you deny"
                                         IsVisible="{Binding IsOpen}" />
                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding IsOpen}">
                                  <Button Classes="primary" Content="Allow" Command="{Binding AllowCommand}" />
                                  <Button Classes="ghost"
                                          Content="{Binding AlwaysLabel}"
                                          Command="{Binding AlwaysAllowCommand}"
                                          IsVisible="{Binding CanAlwaysAllow}" />
                                  <Button Classes="ghost" Content="Deny" Command="{Binding DenyCommand}" />
                                </WrapPanel>
                                <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding Verdict}" IsVisible="{Binding !IsOpen}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                          <DataTemplate DataType="messages:AxiomProposalItemViewModel">
                            <Border Classes="approval" Classes.open="{Binding IsOpen}">
                              <StackPanel Spacing="10">
                                <TextBlock FontSize="{StaticResource FontSizeBody}" Text="{Binding Asking}" />
                                <Border Padding="12,9"
                                        CornerRadius="7"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Background="{DynamicResource BackgroundBrush}">
                                  <prose:ProseText FontSize="{StaticResource FontSizeContent}" TextWrapping="Wrap" Text="{Binding Axiom}" />
                                </Border>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding IsOpen}">
                                  <Button Classes="primary" Content="Approve" Command="{Binding ApproveCommand}" />
                                  <Button Classes="ghost" Content="Decline" Command="{Binding DeclineCommand}" />
                                </WrapPanel>
                                <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding Verdict}" IsVisible="{Binding !IsOpen}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                          <DataTemplate DataType="messages:SummaryProposalItemViewModel">
                            <Border Classes="approval" Classes.open="{Binding IsOpen}">
                              <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                  <TextBlock FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Asking}" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button Classes="chip" Classes.chosen="{Binding ShowsPreview}" Content="Preview" Command="{Binding ShowPreviewCommand}" />
                                    <Button Classes="chip" Classes.chosen="{Binding ShowsChanges}" Content="Changes" Command="{Binding ShowChangesCommand}" />
                                  </StackPanel>
                                </Grid>
                                <Border Classes="prose-preview" IsVisible="{Binding ShowsPreview}">
                                  <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
                                    <prose:ProseView Markdown="{Binding Proposed}" />
                                  </ScrollViewer>
                                </Border>
                                <Border Padding="12,9"
                                        CornerRadius="7"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Background="{DynamicResource BackgroundBrush}"
                                        IsVisible="{Binding ShowsChanges}">
                                  <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="messages:SummaryLine">
                                          <TextBlock FontFamily="{StaticResource MonoFont}"
                                                               FontSize="{StaticResource FontSizeCallout}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                               Classes.added="{Binding IsAdded}"
                                                               Classes.removed="{Binding IsRemoved}"
                                                               Text="{Binding Marked}">
                                            <TextBlock.Styles>
                                              <Style Selector="TextBlock.added">
                                                <Setter Property="Foreground" Value="{DynamicResource AddedBrush}" />
                                              </Style>
                                              <Style Selector="TextBlock.removed">
                                                <Setter Property="Foreground" Value="{DynamicResource RemovedBrush}" />
                                              </Style>
                                            </TextBlock.Styles>
                                          </TextBlock>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </ScrollViewer>
                                </Border>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding IsOpen}">
                                  <Button Classes="primary" Content="Approve" Command="{Binding ApproveCommand}" />
                                  <Button Classes="ghost" Content="Decline" Command="{Binding DeclineCommand}" />
                                </WrapPanel>
                                <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding Verdict}" IsVisible="{Binding !IsOpen}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                          <DataTemplate DataType="messages:QuestionItemViewModel">
                            <Border Classes="approval" Classes.open="{Binding IsOpen}">
                              <StackPanel Spacing="14">
                                <TextBlock FontSize="{StaticResource FontSizeBody}" Text="{Binding Asking}" />
                                <ItemsControl ItemsSource="{Binding Questions}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <StackPanel Spacing="16" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="messages:QuestionCardViewModel">
                                      <StackPanel Spacing="8">
                                        <TextBlock Classes="mono" Text="{Binding Header}" IsVisible="{Binding HasHeader}" />
                                        <TextBlock FontSize="{StaticResource FontSizeContent}" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Text}" />
                                        <StackPanel Spacing="8" IsVisible="{Binding IsOpen}">
                                          <TextBlock FontSize="{StaticResource FontSizeCallout}" Foreground="{DynamicResource ForegroundMutedBrush}" Text="{Binding Hint}" />
                                          <ItemsControl ItemsSource="{Binding Picks}">
                                            <ItemsControl.ItemsPanel>
                                              <ItemsPanelTemplate>
                                                <StackPanel Spacing="6" />
                                              </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                              <DataTemplate DataType="messages:PickItemViewModel">
                                                <Button Classes="pick"
                                                        Classes.chosen="{Binding IsChosen}"
                                                        Command="{Binding ToggleCommand}"
                                                        AutomationProperties.Name="{Binding Label}">
                                                  <StackPanel Spacing="2">
                                                    <TextBlock FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Text="{Binding Label}" />
                                                    <TextBlock FontSize="{StaticResource FontSizeCallout}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                                               Text="{Binding Description}"
                                                               IsVisible="{Binding HasDescription}" />
                                                  </StackPanel>
                                                </Button>
                                              </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                          </ItemsControl>
                                          <TextBox Classes="feedback"
                                                   Text="{Binding Other}"
                                                   PlaceholderText="Something else…"
                                                   AutomationProperties.Name="Your own answer" />
                                        </StackPanel>
                                        <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding Answer}" IsVisible="{Binding !IsOpen}" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsOpen}">
                                  <Button Classes="primary" Content="Answer" Command="{Binding SubmitCommand}" />
                                  <Button Classes="ghost" Content="Skip" Command="{Binding SkipCommand}" />
                                </StackPanel>
                                <TextBlock Classes="mono" Text="{Binding Verdict}" IsVisible="{Binding !IsOpen}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.DataTemplates>
                      </ItemsControl>
                      <Border Classes="note" Classes.failure="{Binding HasFailed}" IsVisible="{Binding HasNote}">
                        <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding Note}" />
                      </Border>
                      <StackPanel Classes="tools" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDone}">
                        <Button Classes="chip" Content="Copy" Command="{Binding CopyCommand}" />
                        <Button Classes="chip" Content="Retry" Command="{Binding RetryCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </DataTemplate>

                <DataTemplate DataType="messages:ResumedMarkViewModel">
                  <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,0,0,26">
                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Text}" />
                    <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <Border Classes="mentions" IsVisible="{Binding Mentions.IsOpen}">
          <ItemsControl ItemsSource="{Binding Mentions.Choices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="composing:MentionViewModel">
                <Button Classes="mention" Classes.chosen="{Binding IsSelected}" Click="Mention" AutomationProperties.Name="{Binding Path}">
                  <Grid ColumnDefinitions="16,Auto,*" ColumnSpacing="10">
                    <Path Width="16"
                          Height="16"
                          StrokeThickness="1"
                          VerticalAlignment="Center"
                          Stroke="{DynamicResource ForegroundMutedBrush}"
                          Data="M1.5,4.5 H5.5 L7,6 H14.5 V13 H1.5 Z"
                          IsVisible="{Binding IsFolder}" />
                    <Path Width="16"
                          Height="16"
                          StrokeThickness="1"
                          VerticalAlignment="Center"
                          Stroke="{DynamicResource ForegroundMutedBrush}"
                          Data="M3.5,1.5 H9.5 L12.5,4.5 V14.5 H3.5 Z M9.5,1.5 V4.5 H12.5"
                          IsVisible="{Binding IsFile}" />
                    <Path Width="16"
                          Height="16"
                          StrokeThickness="1"
                          VerticalAlignment="Center"
                          Stroke="{DynamicResource AccentTextBrush}"
                          Data="M2.5,2.5 H13.5 V13.5 H2.5 Z M9.5,4.5 L6.5,11.5"
                          IsVisible="{Binding IsSkill}" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Name}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="folders:NamePart">
                          <TextBlock Classes.hit="{Binding IsHit}" Text="{Binding Text}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Column="2" Classes="where" TextTrimming="LeadingCharacterEllipsis" Text="{Binding Folder}" IsVisible="{Binding HasFolder}" />
                    <TextBlock Grid.Column="2" Classes="where" TextTrimming="CharacterEllipsis" Text="{Binding Description}" IsVisible="{Binding IsSkill}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Button x:Name="Jump"
                Classes="jump"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,12"
                Content="↓ Latest"
                IsVisible="False"
                Click="ToLatest" />
      </Panel>
    </DockPanel>

    <Panel x:Name="DropZone" IsVisible="False" IsHitTestVisible="False">
      <Border Background="{DynamicResource ScrimBrush}" />
      <Rectangle Margin="16"
                 RadiusX="10"
                 RadiusY="10"
                 Stroke="{DynamicResource AccentBrush}"
                 StrokeThickness="2"
                 StrokeDashArray="4,3" />
      <TextBlock HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontSize="{StaticResource FontSizeTitle3}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource ForegroundBrush}"
                 Text="Drop files to attach" />
    </Panel>
  </Panel>
</UserControl>
