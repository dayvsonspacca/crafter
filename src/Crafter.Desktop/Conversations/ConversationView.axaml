<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversations="using:Crafter.Presentation.Conversations"
             xmlns:messages="using:Crafter.Presentation.Conversations.Messages"
             xmlns:composing="using:Crafter.Presentation.Conversations.Composing"
             xmlns:background="using:Crafter.Presentation.Conversations.Background"
             xmlns:folders="using:Crafter.Presentation.Folders"
             xmlns:core="using:Crafter.Core.Conversations"
             xmlns:conversationViews="using:Crafter.Desktop.Conversations"
             xmlns:controls="using:Crafter.Desktop.Controls"
             xmlns:prose="using:Crafter.Desktop.Prose"
             x:Class="Crafter.Desktop.Conversations.ConversationView"
             x:DataType="conversations:ConversationViewModel">
  <UserControl.Styles>

    <Style Selector="Border.pill">
      <Setter Property="Padding" Value="9,2" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill.agent TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.pill.crafting">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.pill.crafting TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <Style Selector="Border.pill.waiting">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>
    <Style Selector="Border.pill.waiting TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>
    <Style Selector="ItemsControl.aside">
      <Setter Property="Margin" Value="8,10,0,12" />
    </Style>
    <Style Selector="StackPanel.activity">
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.act">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.act:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.act:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Button.act TextBlock.what">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Border.output">
      <Setter Property="Margin" Value="0,2,0,8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    </Style>
    <Style Selector="Border.approval">
      <Setter Property="Margin" Value="0,6,0,16" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Border.approval.open">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>

    <Style Selector="TextBox.feedback">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.pick">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.pick:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pick:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.pick.chosen /template/ ContentPresenter#PART_ContentPresenter, Button.pick.chosen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Border.slot">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Rectangle.wire">
      <Setter Property="Width" Value="2" />
      <Setter Property="Margin" Value="0,6" />
      <Setter Property="RadiusX" Value="1" />
      <Setter Property="RadiusY" Value="1" />
      <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="UniformGrid.cells">
      <Setter Property="Width" Value="19" />
      <Setter Property="Height" Value="19" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.cell">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="5" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="UniformGrid.done Border.cell.lit">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="UniformGrid.crafting Border.c0">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.00" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c1">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.13" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c2">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.26" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c3">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.39" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c4">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.52" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c5">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.65" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c6">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.78" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c7">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.91" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c8">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:1.04" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Button.earlier">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Margin" Value="0,0,0,26" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.earlier:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.jump">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.jump:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style Selector="Border.composer">
      <Setter Property="MaxWidth" Value="760" />
      <Setter Property="Padding" Value="16,12,12,12" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusContainer}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <!-- The same two shadows as the glow, clear, so focusing fades it in. -->
      <Setter Property="BoxShadow" Value="0 0 0 3 #00000000, 0 0 18 0 #00000000" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.composer:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource ComposerGlow}" />
    </Style>
    <Style Selector="Border.composer TextBlock.hint">
      <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.composer:focus-within TextBlock.hint">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBox.prompt">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MaxHeight" Value="240" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeContent}" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="TextBox.prompt /template/ Border#PART_BorderElement, TextBox.prompt:pointerover /template/ Border#PART_BorderElement, TextBox.prompt:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.sidebar">
      <Setter Property="Width" Value="300" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="TextBlock.empty">
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="Button.icon.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    </Style>
    <Style Selector="Button.icon.on Path">
      <Setter Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.job">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.job:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.job:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.job TextBlock.what">
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Path.glyph">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="StrokeThickness" Value="1.2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Stroke" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="Border.mentions">
      <Setter Property="MaxWidth" Value="760" />
      <Setter Property="Margin" Value="24,0,24,6" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="BoxShadow" Value="0 6 18 0 #40000000" />
    </Style>
    <Style Selector="Button.mention">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.mention:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.mention:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.mention.chosen /template/ ContentPresenter#PART_ContentPresenter, Button.mention.chosen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    </Style>
    <Style Selector="Button.mention TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.mention TextBlock.hit">
      <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.mention TextBlock.where">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="Border.picture">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="64" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    </Style>
    <Style Selector="Border.picture.sent">
      <Setter Property="Width" Value="120" />
      <Setter Property="Height" Value="90" />
    </Style>
    <Style Selector="Button.unattach">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,-6,-6,0" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="Button.unattach:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.unattach:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.stop">
      <Setter Property="Height" Value="{StaticResource ControlLarge}" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.stop /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.stop:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.stop:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="StackPanel.tools">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Grid.answer:pointerover StackPanel.tools, Grid.answer.last StackPanel.tools, StackPanel.tools:focus-within">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.note">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.note.failure">
      <Setter Property="BorderBrush" Value="{DynamicResource RemovedBrush}" />
    </Style>
    <Style Selector="Border.note.failure TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RemovedBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top"
            Height="{StaticResource HeaderHeight}"
            Padding="16,0"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
        <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" MaxWidth="420" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
        <Border Grid.Column="1" Classes="pill waiting" IsVisible="{Binding IsWaiting}">
          <TextBlock Classes="mono" Text="waiting for you" />
        </Border>
        <Border Grid.Column="1" Classes="pill crafting" IsVisible="{Binding ShowsClock}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <UniformGrid Classes="cells crafting" Rows="3" Columns="3" Width="13" Height="13">
              <Border Classes="cell c0" Width="3" Height="3" />
              <Border Classes="cell c1" Width="3" Height="3" />
              <Border Classes="cell c2" Width="3" Height="3" />
              <Border Classes="cell c3" Width="3" Height="3" />
              <Border Classes="cell c4" Width="3" Height="3" />
              <Border Classes="cell c5" Width="3" Height="3" />
              <Border Classes="cell c6" Width="3" Height="3" />
              <Border Classes="cell c7" Width="3" Height="3" />
              <Border Classes="cell c8" Width="3" Height="3" />
            </UniformGrid>
            <TextBlock Classes="mono" Text="{Binding Elapsed}" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
          <Border Classes="pill agent">
            <TextBlock Classes="mono" Text="{Binding AgentName}" />
          </Border>
          <Border Classes="pill" IsVisible="{Binding HasModel}">
            <TextBlock Classes="mono" Text="{Binding Model}" />
          </Border>
          <Button Classes="icon" Classes.on="{Binding IsPanelOpen}" Command="{Binding TogglePanelCommand}" ToolTip.Tip="Toggle Panel · Ctrl+J" AutomationProperties.Name="Toggle Panel">
            <Path Data="M2.5,3.5 H13.5 V12.5 H2.5 Z M9.5,3.5 V12.5" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Right" Classes="sidebar" IsVisible="{Binding IsPanelOpen}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,16,14,16" Spacing="22">
          <TextBlock Classes="empty" Text="Nothing running. Background jobs show up here." IsVisible="{Binding IsPanelEmpty}" />

          <StackPanel Spacing="6" IsVisible="{Binding HasJobs}">
            <TextBlock Classes="group" Text="Background jobs" />
            <ItemsControl ItemsSource="{Binding Jobs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="background:JobViewModel">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                      <Button Classes="job" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Description}">
                        <Grid ColumnDefinitions="8,16,*,Auto" ColumnSpacing="8">
                          <Ellipse Classes="pulse" Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}" />
                          <Path Grid.Column="1" Classes="glyph" Data="M2.5,3.5 H13.5 V12.5 H2.5 Z M4.5,6 L6.5,8 L4.5,10 M8,10 H11" IsVisible="{Binding IsShell}" />
                          <Path Grid.Column="1" Classes="glyph" Data="M1.5,8 H4.5 L6,4.5 L8.5,11.5 L10,8 H14.5" IsVisible="{Binding IsMonitor}" />
                          <Path Grid.Column="1" Classes="glyph" Data="M8,2 L9.5,6.5 L14,8 L9.5,9.5 L8,14 L6.5,9.5 L2,8 L6.5,6.5 Z" IsVisible="{Binding IsAgent}" />
                          <TextBlock Grid.Column="2" Classes="what" TextTrimming="CharacterEllipsis" Text="{Binding Description}" ToolTip.Tip="{Binding Kind}" />
                          <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Elapsed}" />
                        </Grid>
                      </Button>
                      <Button Grid.Column="1"
                              Classes="chip"
                              Margin="4,0,0,0"
                              Content="Stop"
                              Command="{Binding StopCommand}"
                              IsEnabled="{Binding !IsStopping}"
                              AutomationProperties.Name="Stop this job" />
                    </Grid>
                    <Border Classes="output" IsVisible="{Binding IsOpen}">
                      <SelectableTextBlock FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                           FontSize="12"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Text="{Binding Output}" />
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="24,8,24,16">
      <Border x:Name="Composer" Classes="composer" DragDrop.AllowDrop="True">
        <StackPanel Spacing="8">
          <ItemsControl ItemsSource="{Binding Attached}" IsVisible="{Binding HasAttached}" Margin="0,6,6,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="10" LineSpacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="composing:AttachmentViewModel">
                <Panel>
                  <Border Classes="picture">
                    <Image Source="{Binding Picture, Converter={x:Static conversationViews:PictureConverter.Instance}}" Stretch="UniformToFill" />
                  </Border>
                  <Button Classes="unattach" Content="×" Command="{Binding RemoveCommand}" AutomationProperties.Name="Remove picture" />
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <controls:PromptBox x:Name="PromptBox"
                              Classes="prompt"
                              Text="{Binding Draft}"
                              PlaceholderText="Describe the recipe…"
                              AutomationProperties.Name="Message" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space2}">
            <TextBlock Classes="hint" Text="Enter to craft · Shift+Enter for a new line" />
            <Panel Grid.Column="1">
              <Button Classes="primary" Content="Craft" Command="{Binding CraftCommand}" IsVisible="{Binding !IsAsking}" />
              <Button Classes="stop" Content="Stop" Command="{Binding CraftCancelCommand}" IsVisible="{Binding IsAsking}" />
            </Panel>
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <Panel>
      <TextBlock IsVisible="{Binding !HasMessages}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontSize="15"
                 Text="{Binding ProjectName, StringFormat='Start a chat in {0}.'}" />

      <ScrollViewer x:Name="Scroller" IsVisible="{Binding HasMessages}" ScrollChanged="Follow">
        <StackPanel MaxWidth="760" Margin="24,24,24,12">
          <Button Classes="earlier" Content="{Binding EarlierLabel}" Command="{Binding ShowEarlierCommand}" IsVisible="{Binding HasEarlier}" />
          <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="messages:YourMessageViewModel">
                <Grid ColumnDefinitions="28,*" ColumnSpacing="16">
                  <DockPanel>
                    <Border DockPanel.Dock="Top" Classes="slot">
                      <TextBlock HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ForegroundMutedBrush}"
                                 Text="YOU" />
                    </Border>
                    <Rectangle Classes="wire" IsVisible="{Binding !IsLast}" />
                  </DockPanel>
                  <Border Grid.Column="1"
                          Margin="0,0,0,24"
                          Padding="16,12"
                          CornerRadius="10"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource BorderBrush}"
                          Background="{DynamicResource SurfaceBrush}">
                    <StackPanel Spacing="10">
                      <ItemsControl ItemsSource="{Binding Pictures}" IsVisible="{Binding HasPictures}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="8" LineSpacing="8" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="core:Picture">
                            <Border Classes="picture sent">
                              <Image Source="{Binding, Converter={x:Static conversationViews:PictureConverter.Instance}}" Stretch="UniformToFill" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <prose:ProseText Text="{Binding Text}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeContent}" LineHeight="22" IsVisible="{Binding HasText}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </DataTemplate>

              <DataTemplate DataType="messages:CrafterMessageViewModel">
                <Grid Classes="answer" Classes.last="{Binding IsLast}" ColumnDefinitions="28,*" ColumnSpacing="16" Background="Transparent">
                  <DockPanel>
                    <Border DockPanel.Dock="Top" Classes="slot">
                      <UniformGrid Classes="cells" Classes.crafting="{Binding IsCrafting}" Classes.done="{Binding !IsCrafting}" Rows="3" Columns="3">
                        <Border Classes="cell c0 lit" />
                        <Border Classes="cell c1 lit" />
                        <Border Classes="cell c2 lit" />
                        <Border Classes="cell c3 lit" />
                        <Border Classes="cell c4" />
                        <Border Classes="cell c5 lit" />
                        <Border Classes="cell c6 lit" />
                        <Border Classes="cell c7 lit" />
                        <Border Classes="cell c8 lit" />
                      </UniformGrid>
                    </Border>
                    <Rectangle Classes="wire" IsVisible="{Binding !IsLast}" />
                  </DockPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,0,32" Spacing="{StaticResource Space3}">
                    <TextBlock Classes="mono" Margin="8,3,0,0" Text="woke up · a background job reported" IsVisible="{Binding IsWoken}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.DataTemplates>
                        <DataTemplate DataType="messages:TextSegmentViewModel">
                          <ItemsControl ItemsSource="{Binding Pieces}" Classes.aside="{Binding FollowsActivity}">
                            <ItemsControl.DataTemplates>
                              <DataTemplate DataType="messages:ProseViewModel">
                                <prose:ProseView Markdown="{Binding Text}" />
                              </DataTemplate>
                              <DataTemplate DataType="messages:CodeBlockViewModel">
                                <Border Margin="0,4,0,12"
                                        CornerRadius="9"
                                        ClipToBounds="True"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Background="{DynamicResource BackgroundBrush}">
                                  <DockPanel>
                                    <Border DockPanel.Dock="Top"
                                            Padding="12,5,6,5"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                      <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="mono" Text="{Binding Language}" />
                                        <Button Grid.Column="1" Classes="chip" Content="Copy" Command="{Binding CopyCommand}" />
                                      </Grid>
                                    </Border>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                      <controls:HighlightedCode Margin="14,12"
                                                                     FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                                                     FontSize="{StaticResource FontSizeCallout}"
                                                                     LineHeight="20"
                                                                     Tokens="{Binding Tokens}" />
                                    </ScrollViewer>
                                  </DockPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.DataTemplates>
                          </ItemsControl>
                        </DataTemplate>
                        <DataTemplate DataType="messages:ActivityItemViewModel">
                          <StackPanel Classes="activity">
                            <Button Classes="act" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Summary}">
                              <Grid ColumnDefinitions="14,52,*,Auto" ColumnSpacing="10">
                                <Panel Width="8" Height="8" VerticalAlignment="Center">
                                  <Ellipse Classes="pulse" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsRunning}" />
                                  <Ellipse Fill="{DynamicResource AddedBrush}" IsVisible="{Binding IsFine}" />
                                  <Ellipse Fill="{DynamicResource RemovedBrush}" IsVisible="{Binding IsFailed}" />
                                </Panel>
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Tool}" />
                                <TextBlock Grid.Column="2" Classes="mono what" TextTrimming="CharacterEllipsis" Text="{Binding Summary}" />
                                <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Result}" />
                              </Grid>
                            </Button>
                            <Border Classes="output" IsVisible="{Binding IsExpanded}">
                              <prose:ProseText FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                               FontSize="12"
                                               LineHeight="19"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               Text="{Binding Output}" />
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="messages:ApprovalItemViewModel">
                          <Border Classes="approval" Classes.open="{Binding IsOpen}">
                            <StackPanel Spacing="10">
                              <TextBlock FontSize="{StaticResource FontSizeBody}" Text="{Binding Asking}" />
                              <Border Padding="12,9"
                                      CornerRadius="7"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      Background="{DynamicResource BackgroundBrush}">
                                <prose:ProseText FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                                 FontSize="13"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding Summary}" />
                              </Border>
                              <TextBlock FontSize="{StaticResource FontSizeCallout}"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource ForegroundMutedBrush}"
                                         Text="{Binding Reason}"
                                         IsVisible="{Binding HasReason}" />
                              <TextBox Classes="feedback"
                                       Text="{Binding Feedback}"
                                       PlaceholderText="{Binding FeedbackHint}"
                                       AutomationProperties.Name="Why you deny"
                                       IsVisible="{Binding IsOpen}" />
                              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding IsOpen}">
                                <Button Classes="primary" Content="Allow" Command="{Binding AllowCommand}" />
                                <Button Classes="ghost"
                                        Content="{Binding AlwaysLabel}"
                                        Command="{Binding AlwaysAllowCommand}"
                                        IsVisible="{Binding CanAlwaysAllow}" />
                                <Button Classes="ghost" Content="Deny" Command="{Binding DenyCommand}" />
                              </WrapPanel>
                              <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding Verdict}" IsVisible="{Binding !IsOpen}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                        <DataTemplate DataType="messages:QuestionItemViewModel">
                          <Border Classes="approval" Classes.open="{Binding IsOpen}">
                            <StackPanel Spacing="14">
                              <TextBlock FontSize="{StaticResource FontSizeBody}" Text="{Binding Asking}" />
                              <ItemsControl ItemsSource="{Binding Questions}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Spacing="16" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="messages:QuestionCardViewModel">
                                    <StackPanel Spacing="8">
                                      <TextBlock Classes="mono" Text="{Binding Header}" IsVisible="{Binding HasHeader}" />
                                      <TextBlock FontSize="{StaticResource FontSizeContent}" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Text}" />
                                      <StackPanel Spacing="8" IsVisible="{Binding IsOpen}">
                                        <TextBlock FontSize="{StaticResource FontSizeCallout}" Foreground="{DynamicResource ForegroundMutedBrush}" Text="{Binding Hint}" />
                                        <ItemsControl ItemsSource="{Binding Picks}">
                                          <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                              <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                          </ItemsControl.ItemsPanel>
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="messages:PickItemViewModel">
                                              <Button Classes="pick"
                                                      Classes.chosen="{Binding IsChosen}"
                                                      Command="{Binding ToggleCommand}"
                                                      AutomationProperties.Name="{Binding Label}">
                                                <StackPanel Spacing="2">
                                                  <TextBlock FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Text="{Binding Label}" />
                                                  <TextBlock FontSize="{StaticResource FontSizeCallout}"
                                                             TextWrapping="Wrap"
                                                             Foreground="{DynamicResource ForegroundMutedBrush}"
                                                             Text="{Binding Description}"
                                                             IsVisible="{Binding HasDescription}" />
                                                </StackPanel>
                                              </Button>
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox Classes="feedback"
                                                 Text="{Binding Other}"
                                                 PlaceholderText="Something else…"
                                                 AutomationProperties.Name="Your own answer" />
                                      </StackPanel>
                                      <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding Answer}" IsVisible="{Binding !IsOpen}" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsOpen}">
                                <Button Classes="primary" Content="Answer" Command="{Binding SubmitCommand}" />
                                <Button Classes="ghost" Content="Skip" Command="{Binding SkipCommand}" />
                              </StackPanel>
                              <TextBlock Classes="mono" Text="{Binding Verdict}" IsVisible="{Binding !IsOpen}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.DataTemplates>
                    </ItemsControl>
                    <Border Classes="note" Classes.failure="{Binding HasFailed}" IsVisible="{Binding HasNote}">
                      <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding Note}" />
                    </Border>
                    <StackPanel Classes="tools" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDone}">
                      <Button Classes="chip" Content="Copy" Command="{Binding CopyCommand}" />
                      <Button Classes="chip" Content="Retry" Command="{Binding RetryCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </DataTemplate>

              <DataTemplate DataType="messages:ResumedMarkViewModel">
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,0,0,26">
                  <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Text}" />
                  <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <Border Classes="mentions" IsVisible="{Binding Mentions.IsOpen}">
        <ItemsControl ItemsSource="{Binding Mentions.Choices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="composing:MentionViewModel">
              <Button Classes="mention" Classes.chosen="{Binding IsSelected}" Click="Mention" AutomationProperties.Name="{Binding Path}">
                <Grid ColumnDefinitions="16,Auto,*" ColumnSpacing="10">
                  <Path Width="16"
                        Height="16"
                        StrokeThickness="1"
                        VerticalAlignment="Center"
                        Stroke="{DynamicResource ForegroundMutedBrush}"
                        Data="M1.5,4.5 H5.5 L7,6 H14.5 V13 H1.5 Z"
                        IsVisible="{Binding IsFolder}" />
                  <Path Width="16"
                        Height="16"
                        StrokeThickness="1"
                        VerticalAlignment="Center"
                        Stroke="{DynamicResource ForegroundMutedBrush}"
                        Data="M3.5,1.5 H9.5 L12.5,4.5 V14.5 H3.5 Z M9.5,1.5 V4.5 H12.5"
                        IsVisible="{Binding IsFile}" />
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Name}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="folders:NamePart">
                        <TextBlock Classes.hit="{Binding IsHit}" Text="{Binding Text}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Grid.Column="2" Classes="where" TextTrimming="LeadingCharacterEllipsis" Text="{Binding Folder}" IsVisible="{Binding HasFolder}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Button x:Name="Jump"
              Classes="jump"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,12"
              Content="↓ Latest"
              IsVisible="False"
              Click="ToLatest" />
    </Panel>
  </DockPanel>
</UserControl>
