<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
             xmlns:mdc="clr-namespace:Markdown.Avalonia.StyleCollections;assembly=Markdown.Avalonia"
             xmlns:conversations="using:Crafter.Presentation.Conversations"
             xmlns:messages="using:Crafter.Presentation.Conversations.Messages"
             xmlns:controls="using:Crafter.Desktop.Controls"
             x:Class="Crafter.Desktop.Conversations.ConversationView"
             x:DataType="conversations:ConversationScreen">
  <UserControl.Styles>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>

    <Style Selector="Border.pill">
      <Setter Property="Padding" Value="9,2" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill.agent TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.pill.crafting">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.pill.crafting TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.chooser">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="10,0,8,0" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chooser:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.chooser:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Button.chooser.changed /template/ ContentPresenter#PART_ContentPresenter, Button.chooser.changed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>
    <Style Selector="Button.chooser.changed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>

    <Style Selector="Border.pill.waiting">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>
    <Style Selector="Border.pill.waiting TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>
    <Style Selector="StackPanel.activity">
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.act">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.act:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.act:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Button.act TextBlock.what">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Border.output">
      <Setter Property="Margin" Value="84,2,0,8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    </Style>
    <Style Selector="Border.approval">
      <Setter Property="Margin" Value="0,6,0,16" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Border.approval.open">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>
    <Style Selector="Button.allow">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.allow /template/ ContentPresenter#PART_ContentPresenter, Button.allow:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.allow:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <Style Selector="Button.allow:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="TextBox.feedback">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.pick">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.pick:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pick:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.pick.chosen /template/ ContentPresenter#PART_ContentPresenter, Button.pick.chosen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Border.slot">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Rectangle.wire">
      <Setter Property="Width" Value="2" />
      <Setter Property="Margin" Value="0,6" />
      <Setter Property="RadiusX" Value="1" />
      <Setter Property="RadiusY" Value="1" />
      <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="UniformGrid.cells">
      <Setter Property="Width" Value="19" />
      <Setter Property="Height" Value="19" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.cell">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="5" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="UniformGrid.done Border.cell.lit">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="UniformGrid.crafting Border.c0">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.00" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c1">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.13" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c2">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.26" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c3">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.39" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c4">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.52" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c5">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.65" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c6">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.78" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c7">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.91" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UniformGrid.crafting Border.c8">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:1.04" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Button.tool">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.earlier">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Margin" Value="0,0,0,26" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.earlier:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.jump">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.jump:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style Selector="Border.composer">
      <Setter Property="MaxWidth" Value="780" />
      <Setter Property="Padding" Value="16,12,12,10" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Border.composer:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox.prompt">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MaxHeight" Value="240" />
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="TextBox.prompt /template/ Border#PART_BorderElement, TextBox.prompt:pointerover /template/ Border#PART_BorderElement, TextBox.prompt:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.craft, Button.stop">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.craft /template/ ContentPresenter#PART_ContentPresenter, Button.craft:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.craft:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.stop /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.stop:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.stop:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="StackPanel.tools">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Grid.answer:pointerover StackPanel.tools, Grid.answer.last StackPanel.tools">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.note">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.note.failure">
      <Setter Property="BorderBrush" Value="{DynamicResource RemovedBrush}" />
    </Style>
    <Style Selector="Border.note.failure TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RemovedBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top"
            Height="44"
            Padding="24,0"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
        <TextBlock VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" MaxWidth="420" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
        <Border Grid.Column="1" Classes="pill waiting" IsVisible="{Binding IsWaiting}">
          <TextBlock Classes="mono" Text="waiting for you" />
        </Border>
        <Border Grid.Column="1" Classes="pill crafting" IsVisible="{Binding ShowsClock}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <UniformGrid Classes="cells crafting" Rows="3" Columns="3" Width="13" Height="13">
              <Border Classes="cell c0" Width="3" Height="3" />
              <Border Classes="cell c1" Width="3" Height="3" />
              <Border Classes="cell c2" Width="3" Height="3" />
              <Border Classes="cell c3" Width="3" Height="3" />
              <Border Classes="cell c4" Width="3" Height="3" />
              <Border Classes="cell c5" Width="3" Height="3" />
              <Border Classes="cell c6" Width="3" Height="3" />
              <Border Classes="cell c7" Width="3" Height="3" />
              <Border Classes="cell c8" Width="3" Height="3" />
            </UniformGrid>
            <TextBlock Classes="mono" Text="{Binding Elapsed}" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
          <Border Classes="pill agent">
            <TextBlock Classes="mono" Text="{Binding AgentName}" />
          </Border>
          <Border Classes="pill" IsVisible="{Binding HasModel}">
            <TextBlock Classes="mono" Text="{Binding Model}" />
          </Border>
          <ItemsControl ItemsSource="{Binding Choosers}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="conversations:ChatChooser">
                <Button Classes="chooser" Classes.changed="{Binding IsChanged}" AutomationProperties.Name="{Binding Title}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="mono" Text="{Binding Label}" />
                    <TextBlock Classes="mono" FontSize="8" Opacity="0.7" Text="▼" />
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight" ItemsSource="{Binding Options}">
                      <MenuFlyout.ItemContainerTheme>
                        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="conversations:ChooserOption">
                          <Setter Property="Header" Value="{Binding Label}" />
                          <Setter Property="Command" Value="{Binding ChooseCommand}" />
                          <Setter Property="ToggleType" Value="Radio" />
                          <Setter Property="IsChecked" Value="{Binding IsChosen}" />
                        </ControlTheme>
                      </MenuFlyout.ItemContainerTheme>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="24,12,24,18">
      <Border Classes="composer">
        <StackPanel Spacing="8">
          <TextBox x:Name="PromptBox"
                   Classes="prompt"
                   Text="{Binding Draft}"
                   PlaceholderText="Describe the recipe…"
                   AutomationProperties.Name="Message" />
          <Panel HorizontalAlignment="Right">
            <Button Classes="craft" Content="Craft" Command="{Binding CraftCommand}" IsVisible="{Binding !IsCrafting}" />
            <Button Classes="stop" Content="Stop" Command="{Binding CraftCancelCommand}" IsVisible="{Binding IsCrafting}" />
          </Panel>
        </StackPanel>
      </Border>
    </Border>

    <Panel>
      <TextBlock IsVisible="{Binding !HasMessages}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontSize="15"
                 Text="{Binding ProjectName, StringFormat='Start a chat in {0}.'}" />

      <ScrollViewer x:Name="Scroller" IsVisible="{Binding HasMessages}" ScrollChanged="Follow">
        <StackPanel MaxWidth="780" Margin="24,28,24,12">
          <Button Classes="earlier" Content="{Binding EarlierLabel}" Command="{Binding ShowEarlierCommand}" IsVisible="{Binding HasEarlier}" />
          <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="messages:YourMessage">
                <Grid ColumnDefinitions="28,*" ColumnSpacing="16">
                  <DockPanel>
                    <Border DockPanel.Dock="Top" Classes="slot">
                      <TextBlock HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                 FontSize="8.5"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ForegroundMutedBrush}"
                                 Text="YOU" />
                    </Border>
                    <Rectangle Classes="wire" IsVisible="{Binding !IsLast}" />
                  </DockPanel>
                  <Border Grid.Column="1"
                          Margin="0,0,0,22"
                          Padding="16,12"
                          CornerRadius="10"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource BorderBrush}"
                          Background="{DynamicResource SurfaceBrush}">
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14.5" LineHeight="22" />
                  </Border>
                </Grid>
              </DataTemplate>

              <DataTemplate DataType="messages:CrafterMessage">
                <Grid Classes="answer" Classes.last="{Binding IsLast}" ColumnDefinitions="28,*" ColumnSpacing="16" Background="Transparent">
                  <DockPanel>
                    <Border DockPanel.Dock="Top" Classes="slot">
                      <UniformGrid Classes="cells" Classes.crafting="{Binding IsCrafting}" Classes.done="{Binding !IsCrafting}" Rows="3" Columns="3">
                        <Border Classes="cell c0 lit" />
                        <Border Classes="cell c1 lit" />
                        <Border Classes="cell c2 lit" />
                        <Border Classes="cell c3 lit" />
                        <Border Classes="cell c4" />
                        <Border Classes="cell c5 lit" />
                        <Border Classes="cell c6 lit" />
                        <Border Classes="cell c7 lit" />
                        <Border Classes="cell c8 lit" />
                      </UniformGrid>
                    </Border>
                    <Rectangle Classes="wire" IsVisible="{Binding !IsLast}" />
                  </DockPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,0,30" Spacing="10">
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.DataTemplates>
                        <DataTemplate DataType="messages:TextSegment">
                          <ItemsControl ItemsSource="{Binding Pieces}">
                            <ItemsControl.DataTemplates>
                              <DataTemplate DataType="messages:Prose">
                                <md:MarkdownScrollViewer Markdown="{Binding Text}">
                                  <md:MarkdownScrollViewer.MarkdownStyle>
                                    <Styles>
                                      <mdc:MarkdownStyleFluentTheme />
                                      <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CCode">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                        <Setter Property="MonospaceFontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
                                      </Style>
                                    </Styles>
                                  </md:MarkdownScrollViewer.MarkdownStyle>
                                </md:MarkdownScrollViewer>
                              </DataTemplate>
                              <DataTemplate DataType="messages:CodeBlock">
                                <Border Margin="0,4,0,12"
                                        CornerRadius="9"
                                        ClipToBounds="True"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Background="{DynamicResource BackgroundBrush}">
                                  <DockPanel>
                                    <Border DockPanel.Dock="Top"
                                            Padding="12,5,6,5"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                      <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="mono" Text="{Binding Language}" />
                                        <Button Grid.Column="1" Classes="tool" Height="22" Content="Copy" Command="{Binding CopyCommand}" />
                                      </Grid>
                                    </Border>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                      <controls:HighlightedCode Margin="14,12"
                                                                     FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                                                     FontSize="12.5"
                                                                     LineHeight="20"
                                                                     Tokens="{Binding Tokens}" />
                                    </ScrollViewer>
                                  </DockPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.DataTemplates>
                          </ItemsControl>
                        </DataTemplate>
                        <DataTemplate DataType="messages:ActivityItem">
                          <StackPanel Classes="activity">
                            <Button Classes="act" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Summary}">
                              <Grid ColumnDefinitions="14,52,*,Auto" ColumnSpacing="10">
                                <Panel Width="8" Height="8" VerticalAlignment="Center">
                                  <Ellipse Classes="pulse" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsRunning}" />
                                  <Ellipse Fill="{DynamicResource AddedBrush}" IsVisible="{Binding IsFine}" />
                                  <Ellipse Fill="{DynamicResource RemovedBrush}" IsVisible="{Binding IsFailed}" />
                                </Panel>
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Tool}" />
                                <TextBlock Grid.Column="2" Classes="mono what" TextTrimming="CharacterEllipsis" Text="{Binding Summary}" />
                                <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Result}" />
                              </Grid>
                            </Button>
                            <Border Classes="output" IsVisible="{Binding IsExpanded}">
                              <SelectableTextBlock FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                                   FontSize="12"
                                                   LineHeight="19"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   Text="{Binding Output}" />
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="messages:ApprovalItem">
                          <Border Classes="approval" Classes.open="{Binding IsOpen}">
                            <StackPanel Spacing="10">
                              <TextBlock FontSize="13.5" Text="{Binding Asking}" />
                              <Border Padding="12,9"
                                      CornerRadius="7"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      Background="{DynamicResource BackgroundBrush}">
                                <SelectableTextBlock FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                                     FontSize="13"
                                                     TextWrapping="Wrap"
                                                     Text="{Binding Summary}" />
                              </Border>
                              <TextBlock FontSize="12.5"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource ForegroundMutedBrush}"
                                         Text="{Binding Reason}"
                                         IsVisible="{Binding HasReason}" />
                              <TextBox Classes="feedback"
                                       Text="{Binding Feedback}"
                                       PlaceholderText="{Binding FeedbackHint}"
                                       AutomationProperties.Name="Why you deny"
                                       IsVisible="{Binding IsOpen}" />
                              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding IsOpen}">
                                <Button Classes="allow" Content="Allow" Command="{Binding AllowCommand}" />
                                <Button Classes="tool"
                                        Height="34"
                                        Padding="14,0"
                                        Content="{Binding AlwaysLabel}"
                                        Command="{Binding AlwaysAllowCommand}"
                                        IsVisible="{Binding CanAlwaysAllow}" />
                                <Button Classes="tool" Height="34" Padding="14,0" Content="Deny" Command="{Binding DenyCommand}" />
                              </WrapPanel>
                              <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding Verdict}" IsVisible="{Binding !IsOpen}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                        <DataTemplate DataType="messages:QuestionItem">
                          <Border Classes="approval" Classes.open="{Binding IsOpen}">
                            <StackPanel Spacing="14">
                              <TextBlock FontSize="13.5" Text="{Binding Asking}" />
                              <ItemsControl ItemsSource="{Binding Questions}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Spacing="16" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="messages:QuestionCard">
                                    <StackPanel Spacing="8">
                                      <TextBlock Classes="mono" Text="{Binding Header}" IsVisible="{Binding HasHeader}" />
                                      <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Text}" />
                                      <StackPanel Spacing="8" IsVisible="{Binding IsOpen}">
                                        <TextBlock FontSize="12.5" Foreground="{DynamicResource ForegroundMutedBrush}" Text="{Binding Hint}" />
                                        <ItemsControl ItemsSource="{Binding Picks}">
                                          <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                              <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                          </ItemsControl.ItemsPanel>
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="messages:PickItem">
                                              <Button Classes="pick"
                                                      Classes.chosen="{Binding IsChosen}"
                                                      Command="{Binding ToggleCommand}"
                                                      AutomationProperties.Name="{Binding Label}">
                                                <StackPanel Spacing="2">
                                                  <TextBlock FontSize="13.5" TextWrapping="Wrap" Text="{Binding Label}" />
                                                  <TextBlock FontSize="12.5"
                                                             TextWrapping="Wrap"
                                                             Foreground="{DynamicResource ForegroundMutedBrush}"
                                                             Text="{Binding Description}"
                                                             IsVisible="{Binding HasDescription}" />
                                                </StackPanel>
                                              </Button>
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox Classes="feedback"
                                                 Text="{Binding Other}"
                                                 PlaceholderText="Something else…"
                                                 AutomationProperties.Name="Your own answer" />
                                      </StackPanel>
                                      <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding Answer}" IsVisible="{Binding !IsOpen}" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsOpen}">
                                <Button Classes="allow" Content="Answer" Command="{Binding SubmitCommand}" />
                                <Button Classes="tool" Height="34" Padding="14,0" Content="Skip" Command="{Binding SkipCommand}" />
                              </StackPanel>
                              <TextBlock Classes="mono" Text="{Binding Verdict}" IsVisible="{Binding !IsOpen}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.DataTemplates>
                    </ItemsControl>
                    <Border Classes="note" Classes.failure="{Binding HasFailed}" IsVisible="{Binding HasNote}">
                      <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding Note}" />
                    </Border>
                    <StackPanel Classes="tools" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDone}">
                      <Button Classes="tool" Content="Copy" Command="{Binding CopyCommand}" />
                      <Button Classes="tool" Content="Retry" Command="{Binding RetryCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </DataTemplate>

              <DataTemplate DataType="messages:ResumedMark">
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,0,0,26">
                  <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Text}" />
                  <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <Button x:Name="Jump"
              Classes="jump"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,12"
              Content="↓ Latest"
              IsVisible="False"
              Click="ToLatest" />
    </Panel>
  </DockPanel>
</UserControl>
