<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="using:Crafter.Desktop.Themes"
             xmlns:agents="using:Crafter.Presentation.Agents"
             xmlns:preferences="using:Crafter.Presentation.Preferences"
             xmlns:options="using:Crafter.Presentation.Agents.Options"
             xmlns:controls="using:Crafter.Desktop.Controls"
             x:Class="Crafter.Desktop.Preferences.PreferencesView"
             x:DataType="preferences:PreferencesViewModel"
             Focusable="True"
             IsVisible="{Binding IsOpen}">
  <UserControl.Styles>
    <Style Selector="TextBlock.kicker">
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.about">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.status.ready">
      <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.status.attention">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.ready">
      <Setter Property="Fill" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.attention">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.setting">
      <Setter Property="Padding" Value="0,18" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="TextBox.path">
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.group">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.group:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.group:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.group.shown /template/ ContentPresenter#PART_ContentPresenter, Button.group.shown:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    </Style>
    <Style Selector="Button.group.shown TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>


    <Style Selector="Button.theme">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.theme /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.theme:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.theme:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.theme.chosen /template/ ContentPresenter#PART_ContentPresenter, Button.theme.chosen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="ComboBox.choice">
      <Setter Property="MinWidth" Value="260" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="12,0,10,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MaxDropDownHeight" Value="260" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="ComboBox.choice:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <controls:Modal Title="Preferences" Dismissed="Leave">
    <Grid ColumnDefinitions="220,*">
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,14">
        <StackPanel Spacing="2">
          <TextBlock Classes="kicker" Margin="10,4,10,6" Text="APP" />
          <ItemsControl ItemsSource="{Binding AppGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="preferences:PreferenceGroupViewModel">
                <Button Classes="group"
                        Classes.shown="{Binding IsShown}"
                        Command="{Binding $parent[UserControl].((preferences:PreferencesViewModel)DataContext).ShowCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="{Binding Name}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="kicker" Margin="10,18,10,6" Text="AGENTS" />
          <ItemsControl ItemsSource="{Binding AgentGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="preferences:AgentGroupViewModel">
                <Button Classes="group"
                        Classes.shown="{Binding IsShown}"
                        Command="{Binding $parent[UserControl].((preferences:PreferencesViewModel)DataContext).ShowCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" />
                    <Ellipse Grid.Column="1"
                             Classes="dot"
                             Classes.ready="{Binding Agent.IsReady}"
                             Classes.attention="{Binding Agent.NeedsAttention}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Column="1">
        <ContentControl Margin="32,26,32,20" Content="{Binding Shown}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="preferences:AppearanceGroupViewModel">
              <StackPanel>
                <TextBlock Classes="heading" Text="Appearance" />
                <Border Classes="setting" BorderThickness="0">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="title" Text="Theme" />
                    <TextBlock Classes="about" Text="Colors for the whole app." />
                    <ItemsControl Margin="0,4,-12,0" ItemsSource="{Binding Themes}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="preferences:ThemeChoiceViewModel">
                          <Button Classes="theme"
                                  Classes.chosen="{Binding IsChosen}"
                                  Command="{Binding ChooseCommand}"
                                  AutomationProperties.Name="{Binding Theme.Name}">
                            <StackPanel Spacing="10">
                              <Border Height="96" CornerRadius="6" ClipToBounds="True" Background="{Binding Theme.Background, Converter={x:Static themes:HexBrushConverter.Instance}}">
                                <DockPanel>
                                  <Border DockPanel.Dock="Top"
                                          Height="12"
                                          Background="{Binding Theme.Surface, Converter={x:Static themes:HexBrushConverter.Instance}}"
                                          BorderBrush="{Binding Theme.Line, Converter={x:Static themes:HexBrushConverter.Instance}}"
                                          BorderThickness="0,0,0,1">
                                    <Border Width="28" Height="4" CornerRadius="2" Background="{Binding Theme.Muted, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                  </Border>
                                  <Grid ColumnDefinitions="34*,66*">
                                    <Border Background="{Binding Theme.Surface, Converter={x:Static themes:HexBrushConverter.Instance}}" BorderBrush="{Binding Theme.Line, Converter={x:Static themes:HexBrushConverter.Instance}}" BorderThickness="0,0,1,0" Padding="6,7">
                                      <StackPanel Spacing="5">
                                        <Border Height="5" CornerRadius="3" Background="{Binding Theme.Line, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                        <Border Height="5" CornerRadius="3" Margin="0,0,14,0" Background="{Binding Theme.Muted, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                        <Border Height="5" CornerRadius="3" Margin="0,0,8,0" Background="{Binding Theme.Muted, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                      </StackPanel>
                                    </Border>
                                    <DockPanel Grid.Column="1" Margin="8">
                                      <Border DockPanel.Dock="Bottom"
                                              Width="30"
                                              Height="10"
                                              CornerRadius="3"
                                              HorizontalAlignment="Right"
                                              Background="{Binding Theme.Accent, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                      <StackPanel Spacing="6">
                                        <Border Height="5" CornerRadius="3" Margin="0,0,40,0" Background="{Binding Theme.Foreground, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                        <Border Height="5" CornerRadius="3" Margin="0,0,12,0" Background="{Binding Theme.Muted, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                        <Border Height="5" CornerRadius="3" Margin="0,0,60,0" Background="{Binding Theme.AccentSecondary, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                      </StackPanel>
                                    </DockPanel>
                                  </Grid>
                                </DockPanel>
                              </Border>
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Theme.Name}" />
                                <Border Grid.Column="1"
                                        Width="16"
                                        Height="16"
                                        CornerRadius="4"
                                        Background="{DynamicResource AccentBrush}"
                                        IsVisible="{Binding IsChosen}">
                                  <Path Width="10"
                                        Height="10"
                                        Stretch="Uniform"
                                        StrokeThickness="2"
                                        Stroke="{DynamicResource OnAccentBrush}"
                                        Data="M3,8.5 L6.2,11.5 L13,4.5" />
                                </Border>
                              </Grid>
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="preferences:ProjectsGroupViewModel">
              <StackPanel>
                <TextBlock Classes="heading" Text="Projects" />
                <Border Classes="setting" BorderThickness="0">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="title" Text="Projects root" />
                    <TextBlock Classes="about" Text="The folder that holds your projects." />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox Classes="path" Text="{Binding Root}" AutomationProperties.Name="Projects root" />
                      <Button Grid.Column="1" Classes="ghost" Content="Browse…" Command="{Binding BrowseCommand}" />
                    </Grid>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource RemovedBrush}"
                               Text="This folder does not exist."
                               IsVisible="{Binding IsRootMissing}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="preferences:AgentGroupViewModel">
              <StackPanel DataContext="{Binding Agent}" x:DataType="agents:AgentPanelViewModel">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="{Binding AgentName}" />
                    <TextBlock Classes="about" Text="{Binding Summary}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Classes="dot" Classes.ready="{Binding IsReady}" Classes.attention="{Binding NeedsAttention}" />
                      <TextBlock Classes="status"
                                 Classes.ready="{Binding IsReady}"
                                 Classes.attention="{Binding NeedsAttention}"
                                 TextWrapping="Wrap"
                                 Text="{Binding Status}" />
                    </StackPanel>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Top" Content="Check again" Command="{Binding CheckCommand}" />
                </Grid>

                <Border Margin="0,14,0,0"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding HasRemedy}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <SelectableTextBlock VerticalAlignment="Center"
                                         TextWrapping="Wrap"
                                         FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                         FontSize="13"
                                         Text="{Binding Remedy}" />
                    <Button Grid.Column="1" Classes="chip" Content="Copy" Command="{Binding CopyRemedyCommand}" />
                  </Grid>
                </Border>

                <Border Classes="setting">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <CheckBox IsChecked="{Binding IsMarked}"
                              IsEnabled="{Binding !IsLocked}"
                              VerticalAlignment="Top"
                              MinWidth="0"
                              Padding="0"
                              AutomationProperties.Name="{Binding AgentName, StringFormat='Use {0}'}" />
                    <StackPanel Grid.Column="1" Spacing="6" Margin="0,5,0,0">
                      <TextBlock Classes="title" Text="{Binding AgentName, StringFormat='Use {0}'}" />
                      <TextBlock Classes="about" Text="Available for new chats." />
                    </StackPanel>
                  </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Settings}">
                  <ItemsControl.DataTemplates>
                    <DataTemplate DataType="options:ChoiceSettingViewModel">
                      <Border Classes="setting">
                        <StackPanel Spacing="8">
                          <TextBlock Classes="title" Text="{Binding Title}" />
                          <TextBlock Classes="about" Text="{Binding About}" />
                          <ComboBox Classes="choice"
                                    ItemsSource="{Binding Options}"
                                    SelectedItem="{Binding Chosen}"
                                    AutomationProperties.Name="{Binding Title}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="options:ChoiceOptionViewModel">
                                <TextBlock Text="{Binding Label}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                    <DataTemplate DataType="options:EntrySettingViewModel">
                      <Border Classes="setting">
                        <StackPanel Spacing="8">
                          <TextBlock Classes="title" Text="{Binding Title}" />
                          <TextBlock Classes="about" Text="{Binding About}" />
                          <TextBox Classes="path"
                                   MaxWidth="360"
                                   HorizontalAlignment="Left"
                                   MinWidth="360"
                                   Text="{Binding Text}"
                                   PlaceholderText="{Binding Fallback}"
                                   AutomationProperties.Name="{Binding Title}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.DataTemplates>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </ScrollViewer>
    </Grid>
  </controls:Modal>
</UserControl>
