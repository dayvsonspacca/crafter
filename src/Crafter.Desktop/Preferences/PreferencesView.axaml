<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="using:Crafter.Desktop.Themes"
             xmlns:agents="using:Crafter.Presentation.Agents"
             xmlns:preferences="using:Crafter.Presentation.Preferences"
             xmlns:options="using:Crafter.Presentation.Agents.Options"
             xmlns:controls="using:Crafter.Desktop.Controls"
             xmlns:keyboard="using:Crafter.Presentation.Keyboard"
             xmlns:library="using:Crafter.Presentation.Library"
             xmlns:core="using:Crafter.Core.Library"
             x:Class="Crafter.Desktop.Preferences.PreferencesView"
             x:DataType="preferences:PreferencesViewModel"
             Focusable="True"
             IsVisible="{Binding IsOpen}">
  <UserControl.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="{StaticResource FontSizeTitle1}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.about">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="LineHeight" Value="19.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.status.ready">
      <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.status.attention">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.ready">
      <Setter Property="Fill" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.attention">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.setting">
      <Setter Property="Padding" Value="0,16" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.entry">
      <Setter Property="Padding" Value="0,10" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.shortcut">
      <Setter Property="Padding" Value="0,10" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.cap">
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Border.cap TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
    </Style>
    <Style Selector="TextBox.path">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <Style Selector="Button.group">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="{StaticResource Control}" />
      <Setter Property="Padding" Value="{StaticResource PadControl}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>
    <Style Selector="Button.group:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.group:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.group.shown /template/ ContentPresenter#PART_ContentPresenter, Button.group.shown:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    </Style>
    <Style Selector="Button.group.shown TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>


    <Style Selector="Button.theme">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusContainer}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.theme /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.theme:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.theme:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.theme.chosen /template/ ContentPresenter#PART_ContentPresenter, Button.theme.chosen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="ComboBox.choice">
      <Setter Property="MinWidth" Value="260" />
      <Setter Property="Height" Value="{StaticResource ControlLarge}" />
      <Setter Property="Padding" Value="12,0,10,0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="MaxDropDownHeight" Value="260" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="ComboBox.choice:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <controls:Modal Title="Preferences" Dismissed="Leave">
    <Grid ColumnDefinitions="200,*">
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,12">
        <StackPanel Spacing="2">
          <TextBlock Classes="group" Margin="8,4,8,4" Text="App" />
          <ItemsControl ItemsSource="{Binding AppGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="preferences:PreferenceGroupViewModel">
                <Button Classes="group"
                        Classes.shown="{Binding IsShown}"
                        Command="{Binding $parent[UserControl].((preferences:PreferencesViewModel)DataContext).ShowCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="{Binding Name}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="group" Margin="8,16,8,4" Text="Agents" />
          <ItemsControl ItemsSource="{Binding AgentGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="preferences:AgentGroupViewModel">
                <Button Classes="group"
                        Classes.shown="{Binding IsShown}"
                        Command="{Binding $parent[UserControl].((preferences:PreferencesViewModel)DataContext).ShowCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" />
                    <Ellipse Grid.Column="1"
                             Classes="dot"
                             Classes.ready="{Binding Agent.IsReady}"
                             Classes.attention="{Binding Agent.NeedsAttention}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Column="1">
        <ContentControl Margin="32,24" Content="{Binding Shown}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="preferences:AppearanceGroupViewModel">
              <StackPanel>
                <TextBlock Classes="heading" Text="Appearance" />
                <Border Classes="setting" BorderThickness="0">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="title" Text="Theme" />
                    <TextBlock Classes="about" Text="Colors for the whole app. Light or dark follows your system setting." />
                    <ItemsControl Margin="0,4,-12,0" ItemsSource="{Binding Themes}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="preferences:ThemeChoiceViewModel">
                          <Button Classes="theme"
                                  Classes.chosen="{Binding IsChosen}"
                                  Command="{Binding ChooseCommand}"
                                  AutomationProperties.Name="{Binding Theme.Name}">
                            <StackPanel Spacing="10">
                              <Border Height="96" CornerRadius="6" ClipToBounds="True" Background="{Binding Palette.Background, Converter={x:Static themes:HexBrushConverter.Instance}}">
                                <DockPanel>
                                  <Border DockPanel.Dock="Top"
                                          Height="12"
                                          Background="{Binding Palette.Surface, Converter={x:Static themes:HexBrushConverter.Instance}}"
                                          BorderBrush="{Binding Palette.Line, Converter={x:Static themes:HexBrushConverter.Instance}}"
                                          BorderThickness="0,0,0,1">
                                    <Border Width="28" Height="4" CornerRadius="2" Background="{Binding Palette.Muted, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                  </Border>
                                  <Grid ColumnDefinitions="34*,66*">
                                    <Border Background="{Binding Palette.Surface, Converter={x:Static themes:HexBrushConverter.Instance}}" BorderBrush="{Binding Palette.Line, Converter={x:Static themes:HexBrushConverter.Instance}}" BorderThickness="0,0,1,0" Padding="6,7">
                                      <StackPanel Spacing="5">
                                        <Border Height="5" CornerRadius="3" Background="{Binding Palette.Line, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                        <Border Height="5" CornerRadius="3" Margin="0,0,14,0" Background="{Binding Palette.Muted, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                        <Border Height="5" CornerRadius="3" Margin="0,0,8,0" Background="{Binding Palette.Muted, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                      </StackPanel>
                                    </Border>
                                    <DockPanel Grid.Column="1" Margin="8">
                                      <Border DockPanel.Dock="Bottom"
                                              Width="30"
                                              Height="10"
                                              CornerRadius="3"
                                              HorizontalAlignment="Right"
                                              Background="{Binding Palette.Accent, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                      <StackPanel Spacing="6">
                                        <Border Height="5" CornerRadius="3" Margin="0,0,40,0" Background="{Binding Palette.Foreground, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                        <Border Height="5" CornerRadius="3" Margin="0,0,12,0" Background="{Binding Palette.Muted, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                        <Border Height="5" CornerRadius="3" Margin="0,0,60,0" Background="{Binding Palette.AccentSecondary, Converter={x:Static themes:HexBrushConverter.Instance}}" />
                                      </StackPanel>
                                    </DockPanel>
                                  </Grid>
                                </DockPanel>
                              </Border>
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Theme.Name}" />
                                <Border Grid.Column="1"
                                        Width="16"
                                        Height="16"
                                        CornerRadius="4"
                                        Background="{DynamicResource AccentBrush}"
                                        IsVisible="{Binding IsChosen}">
                                  <Path Width="10"
                                        Height="10"
                                        Stretch="Uniform"
                                        StrokeThickness="2"
                                        Stroke="{DynamicResource OnAccentBrush}"
                                        Data="M3,8.5 L6.2,11.5 L13,4.5" />
                                </Border>
                              </Grid>
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="preferences:ProjectsGroupViewModel">
              <StackPanel>
                <TextBlock Classes="heading" Text="Projects" />
                <Border Classes="setting" BorderThickness="0">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="title" Text="Projects root" />
                    <TextBlock Classes="about" Text="The folder that holds your projects." />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox Classes="path" Text="{Binding Root}" AutomationProperties.Name="Projects root" />
                      <Button Grid.Column="1" Classes="ghost" Content="Browse…" Command="{Binding BrowseCommand}" />
                    </Grid>
                    <TextBlock FontSize="{StaticResource FontSizeCallout}"
                               Foreground="{DynamicResource RemovedBrush}"
                               Text="This folder does not exist."
                               IsVisible="{Binding IsRootMissing}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="preferences:LibraryGroupViewModel">
              <StackPanel DataContext="{Binding Library}" x:DataType="library:LibraryViewModel">
                <TextBlock Classes="heading" Text="Library" />
                <Border Classes="setting" BorderThickness="0">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="title" Text="Repository" />
                    <TextBlock Classes="about" Text="One git repository keeps your skills and agents. Crafter clones it with your git access and keeps it in sync on its own; it writes to it only when an agent that manages Crafter saves a skill." />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBox Classes="path"
                               Text="{Binding Draft}"
                               PlaceholderText="git@github.com:you/crafter-library.git"
                               AutomationProperties.Name="Library repository" />
                      <Button Grid.Column="1" Classes="ghost" Content="Link" Command="{Binding LinkCommand}" />
                      <Button Grid.Column="2" Classes="ghost" Content="Sync" Command="{Binding SyncCommand}" IsVisible="{Binding IsLinked}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <Ellipse Classes="dot"
                               Classes.ready="{Binding !HasFailed}"
                               Classes.attention="{Binding HasFailed}"
                               IsVisible="{Binding IsLinked}" />
                      <TextBlock Grid.Column="1" Classes="status" TextWrapping="Wrap" Text="{Binding Status}" />
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="setting" BorderThickness="0" IsVisible="{Binding IsLinked}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="title" Text="Skills" />
                    <TextBlock Classes="about" Text="Every folder under skills/ with a skill.json (name, description, when to use) and an instructions.md. A default reaches every project's agent; give others to one project from its Capabilities in the status bar. Defaults are this Crafter's choice, not the library's." />
                    <TextBlock Classes="about"
                               Text="No skills in the repository yet."
                               IsVisible="{Binding ShowsEmpty}" />
                    <ItemsControl ItemsSource="{Binding Entries}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="library:LibrarySkillViewModel">
                          <Border Classes="entry">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                              <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <TextBlock FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Text="{Binding Skill.Name}" />
                                  <TextBlock Classes="status" VerticalAlignment="Center" Text="{Binding Skill.Id}" />
                                </StackPanel>
                                <TextBlock Classes="about" Text="{Binding Skill.Description}" />
                              </StackPanel>
                              <ToggleSwitch Grid.Column="1"
                                            VerticalAlignment="Top"
                                            IsChecked="{Binding IsDefault}"
                                            OnContent="Default"
                                            OffContent="Default"
                                            AutomationProperties.Name="{Binding Skill.Name, StringFormat='Give {0} to every project'}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Spacing="4" Margin="0,8,0,0" IsVisible="{Binding HasProblems}">
                      <TextBlock Classes="title" Text="Could not read" />
                      <ItemsControl ItemsSource="{Binding Problems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="core:LibraryProblem">
                            <Border Classes="entry">
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <TextBlock Classes="status" Text="{Binding Place}" />
                                <TextBlock Grid.Column="1"
                                           FontSize="{StaticResource FontSizeCallout}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource RemovedBrush}"
                                           Text="{Binding Reason}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="preferences:ShortcutsGroupViewModel">
              <StackPanel>
                <TextBlock Classes="heading" Text="Shortcuts" />
                <ItemsControl ItemsSource="{Binding Groups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="keyboard:ShortcutGroup">
                      <StackPanel Margin="0,24,0,0">
                        <TextBlock Classes="title" Margin="0,0,0,4" Text="{Binding Name}" />
                        <ItemsControl ItemsSource="{Binding Entries}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="keyboard:ShortcutEntry">
                              <Border Classes="shortcut">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                  <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeBody}" Text="{Binding Action}" />
                                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Chords}" AutomationProperties.Name="{Binding Keys}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="keyboard:KeyChord">
                                        <ItemsControl ItemsSource="{Binding Caps}">
                                          <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                              <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                          </ItemsControl.ItemsPanel>
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                              <Border Classes="cap">
                                                <TextBlock Text="{Binding}" />
                                              </Border>
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="preferences:AgentGroupViewModel">
              <StackPanel DataContext="{Binding Agent}" x:DataType="agents:AgentPanelViewModel">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="{Binding AgentName}" />
                    <TextBlock Classes="about" Text="{Binding Summary}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Classes="dot" Classes.ready="{Binding IsReady}" Classes.attention="{Binding NeedsAttention}" />
                      <TextBlock Classes="status"
                                 Classes.ready="{Binding IsReady}"
                                 Classes.attention="{Binding NeedsAttention}"
                                 TextWrapping="Wrap"
                                 Text="{Binding Status}" />
                    </StackPanel>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Top" Content="Check again" Command="{Binding CheckCommand}" />
                </Grid>

                <Border Margin="0,14,0,0"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding HasRemedy}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <SelectableTextBlock VerticalAlignment="Center"
                                         TextWrapping="Wrap"
                                         FontFamily="{StaticResource MonoFont}"
                                         FontSize="{StaticResource FontSizeBody}"
                                         Text="{Binding Remedy}" />
                    <Button Grid.Column="1" Classes="chip" Content="Copy" Command="{Binding CopyRemedyCommand}" />
                  </Grid>
                </Border>

                <Border Classes="setting">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <CheckBox IsChecked="{Binding IsMarked}"
                              IsEnabled="{Binding !IsLocked}"
                              VerticalAlignment="Top"
                              MinWidth="0"
                              Padding="0"
                              AutomationProperties.Name="{Binding AgentName, StringFormat='Use {0}'}" />
                    <StackPanel Grid.Column="1" Spacing="6" Margin="0,5,0,0">
                      <TextBlock Classes="title" Text="{Binding AgentName, StringFormat='Use {0}'}" />
                      <TextBlock Classes="about" Text="Available for new chats." />
                    </StackPanel>
                  </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Settings}">
                  <ItemsControl.DataTemplates>
                    <DataTemplate DataType="options:ChoiceSettingViewModel">
                      <Border Classes="setting">
                        <StackPanel Spacing="8">
                          <TextBlock Classes="title" Text="{Binding Title}" />
                          <TextBlock Classes="about" Text="{Binding About}" />
                          <ComboBox Classes="choice"
                                    ItemsSource="{Binding Options}"
                                    SelectedItem="{Binding Chosen}"
                                    AutomationProperties.Name="{Binding Title}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="options:ChoiceOptionViewModel">
                                <TextBlock Text="{Binding Label}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                    <DataTemplate DataType="options:EntrySettingViewModel">
                      <Border Classes="setting">
                        <StackPanel Spacing="8">
                          <TextBlock Classes="title" Text="{Binding Title}" />
                          <TextBlock Classes="about" Text="{Binding About}" />
                          <TextBox Classes="path"
                                   MaxWidth="360"
                                   HorizontalAlignment="Left"
                                   MinWidth="360"
                                   Text="{Binding Text}"
                                   PlaceholderText="{Binding Fallback}"
                                   AutomationProperties.Name="{Binding Title}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.DataTemplates>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </ScrollViewer>
    </Grid>
  </controls:Modal>
</UserControl>
