<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:status="using:Crafter.Presentation.Status"
             x:Class="Crafter.Desktop.Status.StatusBarView"
             x:DataType="status:StatusBarViewModel">
  <Border Classes="statusbar">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <StackPanel Classes="item" IsVisible="{Binding HasBranch}" ToolTip.Tip="Branch the chat is working on">
        <Path Data="M5,5 V11 M11,6.5 C11,9.5 5,8.5 5,11 M6.5,3.5 A1.5,1.5 0 1 1 3.5,3.5 A1.5,1.5 0 1 1 6.5,3.5 M6.5,12.5 A1.5,1.5 0 1 1 3.5,12.5 A1.5,1.5 0 1 1 6.5,12.5 M12.5,5 A1.5,1.5 0 1 1 9.5,5 A1.5,1.5 0 1 1 12.5,5" />
        <TextBlock Text="{Binding Branch}" />
      </StackPanel>
      <Button Grid.Column="2"
              Classes="status"
              Command="{Binding Chat.ToggleJobsCommand, FallbackValue={x:Null}}"
              IsVisible="{Binding HasChat}"
              ToolTip.Tip="Background jobs · Ctrl+J"
              AutomationProperties.Name="Background jobs">
        <StackPanel Classes="item">
          <Panel Width="16" Height="16">
            <Ellipse Classes="pulse" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding Chat.HasJobs, FallbackValue=False}" />
            <Path Data="M2.5,3.5 H13.5 V12.5 H2.5 Z M4.5,6 L6.5,8 L4.5,10 M8,10 H11" IsVisible="{Binding !Chat.HasJobs, FallbackValue=True}" />
          </Panel>
          <TextBlock Text="{Binding Chat.JobsLabel, FallbackValue={x:Null}}" />
        </StackPanel>
      </Button>
    </Grid>
  </Border>
</UserControl>
