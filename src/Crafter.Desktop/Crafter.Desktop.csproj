<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>crafter</AssemblyName>
    <RootNamespace>Crafter.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
    <!-- AVLN3001: WorkbenchWindow takes its dependencies from Composition, so it has no parameterless constructor. -->
    <NoWarn>$(NoWarn);IL2104;AVLN3001</NoWarn>
  </PropertyGroup>

  <!-- Published builds embed the runtime, so they take the patched one (CVE-2026-111497 is fixed in 10.0.14). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <InternalsVisibleTo Include="Crafter.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Wayland" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Crafter.Core/Crafter.Core.csproj" />
    <ProjectReference Include="../Crafter.Storage/Crafter.Storage.csproj" />
    <ProjectReference Include="../Crafter.Agents.ClaudeCode/Crafter.Agents.ClaudeCode.csproj" />
    <ProjectReference Include="../Crafter.Highlight/Crafter.Highlight.csproj" />
    <ProjectReference Include="../Crafter.Markdown/Crafter.Markdown.csproj" />
    <ProjectReference Include="../Crafter.Presentation/Crafter.Presentation.csproj" />
  </ItemGroup>
</Project>
