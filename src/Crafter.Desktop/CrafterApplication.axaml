<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="using:Crafter.Desktop.Themes"
             x:Class="Crafter.Desktop.CrafterApplication"
             RequestedThemeVariant="{x:Static themes:ThemeVariants.Redstone}">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude x:Key="{x:Static themes:ThemeVariants.Redstone}" Source="/Themes/Redstone.axaml" />
        <ResourceInclude x:Key="{x:Static themes:ThemeVariants.Deepslate}" Source="/Themes/Deepslate.axaml" />
        <ResourceInclude x:Key="{x:Static themes:ThemeVariants.Nether}" Source="/Themes/Nether.axaml" />
        <ResourceInclude x:Key="{x:Static themes:ThemeVariants.Warped}" Source="/Themes/Warped.axaml" />
        <ResourceInclude x:Key="{x:Static themes:ThemeVariants.Copper}" Source="/Themes/Copper.axaml" />
        <ResourceInclude x:Key="{x:Static themes:ThemeVariants.RedstoneLight}" Source="/Themes/RedstoneLight.axaml" />
        <ResourceInclude x:Key="{x:Static themes:ThemeVariants.DeepslateLight}" Source="/Themes/DeepslateLight.axaml" />
        <ResourceInclude x:Key="{x:Static themes:ThemeVariants.NetherLight}" Source="/Themes/NetherLight.axaml" />
        <ResourceInclude x:Key="{x:Static themes:ThemeVariants.WarpedLight}" Source="/Themes/WarpedLight.axaml" />
        <ResourceInclude x:Key="{x:Static themes:ThemeVariants.CopperLight}" Source="/Themes/CopperLight.axaml" />
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Tokens.axaml" />
        <ResourceInclude Source="/Controls/Modal.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
