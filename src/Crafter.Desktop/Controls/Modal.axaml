<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Crafter.Desktop.Controls">
  <ControlTheme x:Key="{x:Type controls:Modal}" TargetType="controls:Modal">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Backdrop" Background="{DynamicResource ScrimBrush}" />
          <Border Name="PART_Dialog"
                  Margin="32"
                  MaxWidth="880"
                  MaxHeight="600"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ClipToBounds="True"
                  CornerRadius="{DynamicResource RadiusWindow}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource BorderBrush}"
                  Background="{DynamicResource BackgroundBrush}"
                  BoxShadow="0 24 64 0 #80000000">
            <DockPanel>
              <Border DockPanel.Dock="Top"
                      Height="44"
                      Padding="20,0,8,0"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeTitle3}" FontWeight="SemiBold" Text="{TemplateBinding Title}" />
                  <Button Name="PART_Close"
                          Grid.Column="1"
                          Width="{DynamicResource Control}"
                          Height="{DynamicResource Control}"
                          Padding="0"
                          CornerRadius="{DynamicResource RadiusControl}"
                          Background="Transparent"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          AutomationProperties.Name="Close">
                    <Button.Styles>
                      <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                      </Style>
                    </Button.Styles>
                    <Path Width="12"
                          Height="12"
                          Stretch="Uniform"
                          StrokeThickness="1.3"
                          Stroke="{DynamicResource ForegroundMutedBrush}"
                          Data="M4,4 L12,12 M12,4 L4,12" />
                  </Button>
                </Grid>
              </Border>
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </DockPanel>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:compact /template/ Border#PART_Dialog">
      <Setter Property="MaxWidth" Value="520" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
