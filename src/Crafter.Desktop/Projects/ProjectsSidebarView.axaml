<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="using:Crafter.Presentation"
             xmlns:projects="using:Crafter.Presentation.Projects"
             xmlns:projectsViews="using:Crafter.Desktop.Projects"
             x:Class="Crafter.Desktop.Projects.ProjectsSidebarView"
             x:DataType="presentation:WorkbenchViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.path, TextBlock.keys">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.keys">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>


    <Style Selector="Button.project">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="{StaticResource Control}" />
      <Setter Property="Padding" Value="{StaticResource PadControl}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.project:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.project:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.project.current /template/ ContentPresenter#PART_ContentPresenter, Button.project.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    </Style>
    <Style Selector="Button.project TextBlock.name">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.project.current TextBlock.name">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.keys.unread">
      <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>

    <Style Selector="Button.foot">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="8" />
      <Setter Property="MinHeight" Value="{StaticResource Control}" />
      <Setter Property="Padding" Value="{StaticResource PadControl}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.foot:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.foot:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.foot.current /template/ ContentPresenter#PART_ContentPresenter, Button.foot.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    </Style>

    <Style Selector="MenuItem.danger">
      <Setter Property="Foreground" Value="{DynamicResource RemovedBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,0,1,0">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="{StaticResource HeaderHeight}" Margin="16,0,8,0" ColumnDefinitions="*,Auto">
        <TextBlock Classes="group" Text="Projects" />
        <Button Grid.Column="1"
                Classes="icon"
                Command="{Binding AddCommand}"
                ToolTip.Tip="Add Project · Ctrl+K Ctrl+O"
                AutomationProperties.Name="Add Project">
          <Path Data="M8,3 V13 M3,8 H13" />
        </Button>
      </Grid>

      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
        <Button Classes="foot"
                Classes.current="{Binding IsShowingPreferences}"
                Command="{Binding TogglePreferencesCommand}"
                AutomationProperties.Name="Preferences">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space2}">
            <Path Width="16"
                  Height="16"
                  StrokeThickness="1"
                  VerticalAlignment="Center"
                  Stroke="{DynamicResource ForegroundMutedBrush}"
                  Data="M10.2,8 A2.2,2.2 0 1 1 10.19,8 Z M8,1.8 V3.5 M8,12.5 V14.2 M1.8,8 H3.5 M12.5,8 H14.2 M3.6,3.6 L4.8,4.8 M11.2,11.2 L12.4,12.4 M3.6,12.4 L4.8,11.2 M11.2,4.8 L12.4,3.6" />
            <TextBlock Grid.Column="1" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" Text="Preferences" />
            <TextBlock Grid.Column="2" Classes="keys" Text="Ctrl+," />
          </Grid>
        </Button>
      </Border>

      <Panel>
        <ScrollViewer IsVisible="{Binding HasProjects}">
          <ItemsControl ItemsSource="{Binding Shelf}" Margin="8,0,8,8">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="projects:ShelfItemViewModel">
                <Button Classes="project"
                        Classes.current="{Binding IsCurrent}"
                        Command="{Binding OpenCommand}"
                        AutomationProperties.Name="{Binding Name}">
                  <Button.ContextFlyout>
                    <MenuFlyout>
                      <MenuItem Command="{Binding EditCommand}">
                        <MenuItem.Header>
                          <Grid ColumnDefinitions="*,Auto" MinWidth="200">
                            <TextBlock Text="Edit Project…" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Margin="24,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeFootnote}" Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center" Text="F2" IsVisible="{Binding IsCurrent}" />
                          </Grid>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Command="{Binding CloseCommand}" IsVisible="{Binding IsCurrent}">
                        <MenuItem.Header>
                          <Grid ColumnDefinitions="*,Auto" MinWidth="200">
                            <TextBlock Text="Close Project" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Margin="24,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeFootnote}" Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center" Text="Ctrl+K F" />
                          </Grid>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Command="{Binding OpenCommand}" IsVisible="{Binding !IsCurrent}">
                        <MenuItem.Header>
                          <Grid ColumnDefinitions="*,Auto" MinWidth="200">
                            <TextBlock Text="Open" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Margin="24,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeFootnote}" Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center" Text="{Binding Keys}" />
                          </Grid>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Header="Copy Path" Command="{Binding CopyPathCommand}" />
                      <Separator />
                      <MenuItem Classes="danger" Header="Remove from Projects" Command="{Binding RemoveCommand}" />
                    </MenuFlyout>
                  </Button.ContextFlyout>
                  <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="8">
                    <Border Width="18"
                            Height="18"
                            CornerRadius="4"
                            ClipToBounds="True"
                            VerticalAlignment="Center"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Background="{DynamicResource SurfaceBrush}">
                      <Panel>
                        <Image Source="{Binding IconFile, Converter={x:Static projectsViews:IconFileConverter.Instance}}" Stretch="UniformToFill" IsVisible="{Binding HasIcon}" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Text="{Binding Letter}"
                                   IsVisible="{Binding !HasIcon}" />
                      </Panel>
                    </Border>
                    <TextBlock Grid.Column="1" Classes="name" VerticalAlignment="Center" Text="{Binding Name}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasChats}">
                      <Ellipse Classes="pulse"
                               Width="6"
                               Height="6"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource AccentBrush}"
                               IsVisible="{Binding IsCrafting}" />
                      <Border MinWidth="18" Height="18" Padding="5,0" CornerRadius="99" Background="{DynamicResource BackgroundBrush}">
                        <TextBlock Classes="keys"
                                   Classes.unread="{Binding HasUnread}"
                                   HorizontalAlignment="Center"
                                   Text="{Binding ChatCount}" />
                      </Border>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock IsVisible="{Binding !HasProjects}"
                   Margin="16,12,16,0"
                   TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeBody}"
                   Foreground="{DynamicResource ForegroundMutedBrush}"
                   Text="No projects yet." />
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
