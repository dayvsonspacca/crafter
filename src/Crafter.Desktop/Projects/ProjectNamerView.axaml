<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:projectsViews="using:Crafter.Desktop.Projects"
             xmlns:namer="using:Crafter.Presentation.Projects.Namer"
             xmlns:controls="using:Crafter.Desktop.Controls"
             x:Class="Crafter.Desktop.Projects.ProjectNamerView"
             x:DataType="namer:ProjectNamerViewModel"
             IsVisible="{Binding IsOpen}">
  <UserControl.Styles>
    <Style Selector="TextBlock.about">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <controls:Modal Title="{Binding Title}" IsCompact="{Binding !IsAdding}" Dismissed="Dismiss">
    <DockPanel Margin="20,22,20,20">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,24,0,0">
        <Button Classes="ghost" Content="{Binding Retreat}" Command="{Binding BackCommand}" />
        <Button Classes="primary" Content="{Binding Confirm}" Command="{Binding FinishCommand}" />
      </StackPanel>

      <StackPanel Spacing="18">
        <StackPanel Spacing="8" IsVisible="{Binding IsAdding}">
          <TextBlock Classes="group" Text="Folder" />
          <Border Padding="12,10"
                  CornerRadius="6"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource BorderBrush}"
                  Background="{DynamicResource SurfaceBrush}">
            <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="10">
              <Path Width="16"
                    Height="16"
                    StrokeThickness="1"
                    VerticalAlignment="Center"
                    Stroke="{DynamicResource ForegroundMutedBrush}"
                    Data="M1.5,4.5 H5.5 L7,6 H14.5 V13 H1.5 Z" />
              <TextBlock Grid.Column="1" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" Text="{Binding Folder}" />
              <Border Grid.Column="2"
                      Padding="7,1"
                      CornerRadius="99"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource BorderBrush}"
                      IsVisible="{Binding IsRepository}">
                <TextBlock FontFamily="{StaticResource MonoFont}"
                           FontSize="{StaticResource FontSizeFootnote}"
                           Foreground="{DynamicResource AccentSecondaryBrush}"
                           Text="git" />
              </Border>
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Text="Name" />
          <TextBlock Classes="about" Text="How crafter shows this project." />
          <TextBox x:Name="NameBox" FontSize="{StaticResource FontSizeContent}" Text="{Binding Name}" AutomationProperties.Name="Name" />
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding !IsAdding}">
          <TextBlock FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Text="Project icon" />
          <TextBlock Classes="about" Text="Any image. crafter keeps a copy in the project." />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="44"
                    Height="44"
                    CornerRadius="10"
                    ClipToBounds="True"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource SurfaceBrush}">
              <Panel>
                <Image Source="{Binding PreviewFile, Converter={x:Static projectsViews:IconFileConverter.Instance}}" Stretch="UniformToFill" IsVisible="{Binding HasPreview}" />
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, monospace"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"
                           Text="{Binding Letter}"
                           IsVisible="{Binding !HasPreview}" />
              </Panel>
            </Border>
            <Button Classes="ghost" VerticalAlignment="Center" Content="Choose…" Command="{Binding ChooseIconCommand}" />
            <Button Classes="ghost" VerticalAlignment="Center" Content="Remove" Command="{Binding RemoveIconCommand}" IsVisible="{Binding HasPreview}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </controls:Modal>
</UserControl>
