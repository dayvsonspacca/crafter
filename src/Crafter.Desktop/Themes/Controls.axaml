<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Data people read as code: paths, shortcuts, tool names, times. -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

  <!-- The title of a group of rows: sentence case, never tracked capitals. -->
  <Style Selector="TextBlock.group">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

  <Style Selector="Button.primary, Button.ghost">
    <Setter Property="Height" Value="{StaticResource ControlLarge}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <!-- A small text action beside content: Copy, Retry, Deny. -->
  <Style Selector="Button.chip">
    <Setter Property="Height" Value="{StaticResource ControlSmall}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <!-- A borderless symbol button, 28 by 28. -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="{StaticResource Control}" />
    <Setter Property="Height" Value="{StaticResource Control}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="StrokeThickness" Value="1.1" />
    <Setter Property="Stroke" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Button.icon:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <!-- A chat or a project that is crafting right now. -->
  <Style Selector="Ellipse.pulse">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.35" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Anything you click shows a hand; anything you can select shows a text cursor. -->
  <Style Selector="Button, ToggleButton, CheckBox, ComboBox, ComboBoxItem, ListBoxItem, MenuItem">
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:disabled, ToggleButton:disabled, CheckBox:disabled, ComboBox:disabled, ComboBoxItem:disabled, ListBoxItem:disabled, MenuItem:disabled">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="SelectableTextBlock">
    <Setter Property="Cursor" Value="IBeam" />
    <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
  </Style>

  <!-- Chat text drawn from markdown: ProseView blocks, selected as one text by TextSelection. -->
  <Style Selector="SelectableTextBlock.prose">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeContent}" />
    <Setter Property="LineHeight" Value="22" />
  </Style>
  <Style Selector="SelectableTextBlock.prose.h1">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle1}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="30" />
  </Style>
  <Style Selector="SelectableTextBlock.prose.h2">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle3}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="24" />
  </Style>
  <Style Selector="SelectableTextBlock.prose.h3">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="SelectableTextBlock.prose.marker">
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.prose.code">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style Selector="SelectableTextBlock.prose.td, SelectableTextBlock.prose.th">
    <Setter Property="MaxWidth" Value="360" />
  </Style>
  <Style Selector="SelectableTextBlock.prose.th">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>
  <Style Selector="Border.prose-quote">
    <Setter Property="Padding" Value="12,0,0,0" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="Border.prose-quote SelectableTextBlock.prose">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>
  <Style Selector="Border.prose-code, Border.prose-table">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
  </Style>
  <Style Selector="Border.prose-code">
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.prose-table">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.prose-cell">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="Border.prose-cell.header">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="Border.prose-cell.last">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Rectangle.prose-rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- The status bar along the bottom of the window: quiet mono items, like an editor's. -->
  <Style Selector="Border.statusbar">
    <Setter Property="Height" Value="{StaticResource ControlSmall}" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="Border.statusbar StackPanel.item">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.statusbar TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>
  <Style Selector="Border.statusbar Button.status">
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.statusbar Button.status:pointerover /template/ ContentPresenter#PART_ContentPresenter, Border.statusbar Button.status:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Border.statusbar Button.status:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>
  <Style Selector="Border.statusbar Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="StrokeThickness" Value="1.1" />
    <Setter Property="Stroke" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
