<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="using:Crafter.Desktop.Themes"
             x:Class="Crafter.Desktop.CrafterApplication"
             RequestedThemeVariant="{x:Static themes:Theme.RedstoneVariant}">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude x:Key="{x:Static themes:Theme.RedstoneVariant}" Source="/Themes/Redstone.axaml" />
        <ResourceInclude x:Key="{x:Static themes:Theme.DeepslateVariant}" Source="/Themes/Deepslate.axaml" />
        <ResourceInclude x:Key="{x:Static themes:Theme.NetherVariant}" Source="/Themes/Nether.axaml" />
        <ResourceInclude x:Key="{x:Static themes:Theme.WarpedVariant}" Source="/Themes/Warped.axaml" />
        <ResourceInclude x:Key="{x:Static themes:Theme.CopperVariant}" Source="/Themes/Copper.axaml" />
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Modal.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
