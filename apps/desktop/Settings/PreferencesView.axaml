<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Crafter.Desktop.Settings"
             xmlns:setup="using:Crafter.Desktop.Setup"
             x:Class="Crafter.Desktop.Settings.PreferencesView"
             x:DataType="settings:PreferencesScreen"
             IsVisible="{Binding IsOpen}">
  <UserControl.Styles>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.about">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="Border.setting">
      <Setter Property="Padding" Value="0,18" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="TextBox.path, NumericUpDown">
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.ready">
      <Setter Property="Fill" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.attention">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel MaxWidth="760" Margin="24,40">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock FontSize="26" FontWeight="Medium" Text="Preferences" />
        <TextBlock Grid.Column="1"
                   Classes="mono"
                   VerticalAlignment="Bottom"
                   Text="Esc to go back · saved in ~/.config/crafter/preferences.json" />
      </Grid>

      <TextBlock Classes="mono" Margin="0,32,0,0" LetterSpacing="1.1" Text="PROJECTS" />

      <Border Classes="setting">
        <StackPanel Spacing="8">
          <TextBlock Classes="title" Text="Projects root" />
          <TextBlock Classes="about" Text="Where Add Project starts browsing and where crafter looks for Git repositories." />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="RootBox" Classes="path" Text="{Binding Root}" AutomationProperties.Name="Projects root" />
            <Button Grid.Column="1" Classes="ghost" Content="Browse…" Command="{Binding BrowseCommand}" />
          </Grid>
          <TextBlock FontSize="12"
                     Foreground="{DynamicResource RemovedBrush}"
                     Text="This folder does not exist. The last root that existed is still in use."
                     IsVisible="{Binding IsRootMissing}" />
        </StackPanel>
      </Border>

      <Border Classes="setting">
        <CheckBox IsChecked="{Binding FindsRepositories}" VerticalContentAlignment="Top">
          <StackPanel Spacing="6">
            <TextBlock Classes="title" Text="Find repositories" />
            <TextBlock Classes="about"
                       Text="List the folders under the projects root that hold a Git repository, so you can add them without browsing." />
          </StackPanel>
        </CheckBox>
      </Border>

      <Border Classes="setting">
        <StackPanel Spacing="8">
          <TextBlock Classes="title" Text="Search depth" />
          <TextBlock Classes="about"
                     Text="How many folders deep crafter looks under the root. node_modules, vendor, bin and obj are skipped." />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <NumericUpDown Width="130"
                           Value="{Binding SearchDepth}"
                           Minimum="{Binding ShallowestSearch}"
                           Maximum="{Binding DeepestSearch}"
                           Increment="1"
                           FormatString="0"
                           AutomationProperties.Name="Search depth" />
            <TextBlock Classes="mono" VerticalAlignment="Center" Text="levels" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="mono" Margin="0,32,0,0" LetterSpacing="1.1" Text="AGENTS" />

      <ItemsControl ItemsSource="{Binding Agents}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="setup:AgentCard">
            <Border Classes="setting">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <CheckBox IsChecked="{Binding IsMarked}"
                          IsEnabled="{Binding !IsLocked}"
                          VerticalAlignment="Top"
                          MinWidth="0"
                          Padding="0"
                          AutomationProperties.Name="{Binding AgentName}" />
                <StackPanel Grid.Column="1" Spacing="6" Margin="0,5,0,0">
                  <TextBlock Classes="title" Text="{Binding AgentName}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Classes="dot" Classes.ready="{Binding IsReady}" Classes.attention="{Binding NeedsAttention}" />
                    <TextBlock Classes="about" Text="{Binding Status}" />
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="2"
                        Classes="ghost"
                        VerticalAlignment="Center"
                        Content="Check again"
                        Command="{Binding CheckCommand}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="mono"
                 Margin="0,12,0,0"
                 Text="New chats use the first marked agent. At least one agent stays marked." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
