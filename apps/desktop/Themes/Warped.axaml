<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ColorPaletteResources Accent="#2DBFA0"
                           AltHigh="#0C1514"
                           AltLow="#0C1514"
                           AltMedium="#0C1514"
                           AltMediumHigh="#0C1514"
                           AltMediumLow="#0C1514"
                           BaseHigh="#DCEAE5"
                           BaseLow="#22362F"
                           BaseMedium="#84A39A"
                           BaseMediumHigh="#B0C6C0"
                           BaseMediumLow="#5A716B"
                           ChromeAltLow="#B0C6C0"
                           ChromeBlackHigh="#000000"
                           ChromeBlackLow="#B0C6C0"
                           ChromeBlackMedium="#0C1514"
                           ChromeBlackMediumLow="#0C1514"
                           ChromeDisabledHigh="#22362F"
                           ChromeDisabledLow="#84A39A"
                           ChromeGray="#5A716B"
                           ChromeHigh="#5A716B"
                           ChromeLow="#15221F"
                           ChromeMedium="#1C2C27"
                           ChromeMediumLow="#15221F"
                           ChromeWhite="#DCEAE5"
                           ListLow="#15221F"
                           ListMedium="#22362F"
                           RegionColor="#0C1514" />
  </ResourceDictionary.MergedDictionaries>

  <Color x:Key="BackgroundColor">#0C1514</Color>
  <Color x:Key="SurfaceColor">#15221F</Color>
  <Color x:Key="BorderColor">#22362F</Color>
  <Color x:Key="HoverColor">#1C2C27</Color>
  <Color x:Key="ForegroundColor">#DCEAE5</Color>
  <Color x:Key="ForegroundMutedColor">#84A39A</Color>
  <Color x:Key="AccentColor">#2DBFA0</Color>
  <Color x:Key="AccentSecondaryColor">#E0628A</Color>
  <Color x:Key="AccentSecondaryFaintColor">#66E0628A</Color>
  <Color x:Key="OnAccentColor">#04140F</Color>
  <Color x:Key="AddedColor">#6FD39B</Color>
  <Color x:Key="RemovedColor">#E0628A</Color>
  <Color x:Key="ScrimColor">#9E060A0A</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
  <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
  <SolidColorBrush x:Key="ForegroundMutedBrush" Color="{StaticResource ForegroundMutedColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}" />
  <SolidColorBrush x:Key="AccentSecondaryFaintBrush" Color="{StaticResource AccentSecondaryFaintColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="AddedBrush" Color="{StaticResource AddedColor}" />
  <SolidColorBrush x:Key="RemovedBrush" Color="{StaticResource RemovedColor}" />
  <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />

  <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource ForegroundColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{StaticResource ForegroundColor}" />
  <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="{StaticResource BorderColor}" />
</ResourceDictionary>
