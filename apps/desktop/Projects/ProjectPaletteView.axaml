<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:projects="using:Crafter.Desktop.Projects"
             x:Class="Crafter.Desktop.Projects.ProjectPaletteView"
             x:DataType="projects:ProjectPalette"
             IsVisible="{Binding IsOpen}">
  <UserControl.Styles>
    <Style Selector="TextBlock.hit">
      <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>

    <Style Selector="TextBox.query">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="TextBox.query /template/ Border#PART_BorderElement, TextBox.query:pointerover /template/ Border#PART_BorderElement, TextBox.query:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style Selector="ListBox.picks">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.picks ListBoxItem">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBox.picks ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBox.picks ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.picks ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.picks ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Border Background="Transparent" PointerPressed="Dismiss" />
    <Border Width="600"
            Margin="16,9,16,0"
            Padding="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            BoxShadow="0 20 50 -14 #BF000000">
      <StackPanel Spacing="6">
        <TextBox x:Name="QueryBox"
                 Classes="query"
                 Text="{Binding Query}"
                 PlaceholderText="Search projects by name or path"
                 AutomationProperties.Name="Search projects" />

        <ListBox Classes="picks"
                 ItemsSource="{Binding Picks}"
                 SelectedItem="{Binding Selected}"
                 MaxHeight="360"
                 IsVisible="{Binding HasPicks}"
                 Tapped="Chosen">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="projects:Pick">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="1">
                  <ItemsControl ItemsSource="{Binding Name}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="projects:Piece">
                        <TextBlock FontSize="13.5" Classes.hit="{Binding IsHit}" Text="{Binding Text}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Folder}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="projects:Piece">
                        <TextBlock Classes="mono dim" Classes.hit="{Binding IsHit}" Text="{Binding Text}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Classes="mono dim"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding Shortcut}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Classes="dim"
                   Margin="4,6"
                   Text="No projects match. Ctrl+K Ctrl+O adds a folder."
                   IsVisible="{Binding !HasPicks}" />

        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="4,8,4,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="mono dim" Text="↑↓ to choose · Enter to open · Esc to close" />
            <TextBlock Grid.Column="1" Classes="mono dim" Text="Ctrl+K Ctrl+O to add a folder" />
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
