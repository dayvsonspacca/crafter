<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Crafter.Desktop"
             xmlns:folders="using:Crafter.Presentation.Folders"
             xmlns:folderViews="using:Crafter.Desktop.Folders"
             xmlns:projects="using:Crafter.Presentation.Projects"
             x:Class="Crafter.Desktop.Folders.FolderPickerView"
             x:DataType="folders:FolderPicker"
             IsVisible="{Binding IsOpen}">
  <UserControl.Styles>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.hit">
      <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="LetterSpacing" Value="1.1" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>

    <Style Selector="Border.field">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="TextBox.filter">
      <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, JetBrains Mono, monospace" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style Selector="TextBox.filter /template/ Border#PART_BorderElement, TextBox.filter:pointerover /template/ Border#PART_BorderElement, TextBox.filter:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBox.entries">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.entries ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.entries ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.entries ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.entries ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.entries ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style Selector="Border.tag">
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <local:Modal Title="{Binding Title}" Dismissed="Dismiss">
    <DockPanel Margin="16,14,16,12">
      <Border Classes="field" DockPanel.Dock="Top" Margin="0,0,0,4">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Classes="mono dim" FontSize="13" VerticalAlignment="Center" Text="{Binding LocationLabel}" />
          <TextBox x:Name="FilterBox"
                   Grid.Column="1"
                   Classes="filter"
                   Text="{Binding Filter}"
                   AutomationProperties.Name="Folder" />
        </Grid>
      </Border>

      <ListBox Classes="entries"
               ItemsSource="{Binding Entries}"
               SelectedItem="{Binding Selected}"
               DoubleTapped="Chosen">
        <ListBox.DataTemplates>
          <DataTemplate DataType="folders:PickerHeading">
            <TextBlock Classes="heading" Margin="0,4,0,0" Text="{Binding Text}" />
          </DataTemplate>
          <DataTemplate DataType="folders:FolderChoice">
            <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="10">
              <Path Width="16"
                    Height="16"
                    StrokeThickness="1"
                    VerticalAlignment="Center"
                    Stroke="{DynamicResource ForegroundMutedBrush}"
                    Data="M1.5,4.5 H5.5 L7,6 H14.5 V13 H1.5 Z"
                    IsVisible="{Binding !IsFound}" />
              <Path Width="16"
                    Height="16"
                    StrokeThickness="1"
                    VerticalAlignment="Center"
                    Stroke="{DynamicResource AccentSecondaryBrush}"
                    Data="M6,4 A1.5,1.5 0 1 1 5.99,4 Z M6,12 A1.5,1.5 0 1 1 5.99,12 Z M13,6.5 A1.5,1.5 0 1 1 12.99,6.5 Z M4.5,5.5 V10.5 M11.5,8 C11.5,10 8.5,10 5,11"
                    IsVisible="{Binding IsFound}" />
              <StackPanel Grid.Column="1" Spacing="1">
                <ItemsControl ItemsSource="{Binding Name}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="projects:Piece">
                      <TextBlock FontSize="13.5" Classes.hit="{Binding IsHit}" Text="{Binding Text}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <Border Grid.Column="2"
                      Classes="tag"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource BorderBrush}"
                      IsVisible="{Binding HasTag}">
                <TextBlock Classes="mono" FontSize="10.5" Foreground="{DynamicResource AccentSecondaryBrush}" Text="{Binding Tag}" />
              </Border>
            </Grid>
          </DataTemplate>
          <DataTemplate DataType="folders:ImageChoice">
            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="10">
              <Border Width="24"
                      Height="24"
                      CornerRadius="5"
                      ClipToBounds="True"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource SurfaceBrush}">
                <Image Source="{Binding File, Converter={x:Static folderViews:ThumbnailConverter.Instance}}" Stretch="UniformToFill" />
              </Border>
              <ItemsControl Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding Name}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="projects:Piece">
                    <TextBlock FontSize="13.5" Classes.hit="{Binding IsHit}" Text="{Binding Text}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Grid.Column="2"
                      Classes="tag"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource BorderBrush}">
                <TextBlock Classes="mono dim" FontSize="10.5" Text="{Binding Format}" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>
    </DockPanel>
  </local:Modal>
</UserControl>
